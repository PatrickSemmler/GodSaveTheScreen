<ui:FluentWindow x:Class="GodSaveTheScreen.App.Views.MessageDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 SizeToContent="Height"
                 Width="480"
                 MinHeight="0"
                 Height="Auto"
                 MinWidth="360"
                 MaxWidth="640"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 PreviewKeyDown="OnPreviewKeyDown">
  <StackPanel>
    <ui:TitleBar x:Name="Bar" ShowMinimize="False" ShowMaximize="False" />
    <Grid Margin="24,8,24,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ui:SymbolIcon x:Name="SymbolHost" FontSize="44" Filled="True" Margin="0,0,18,0" VerticalAlignment="Center" />
      <TextBlock x:Name="MessageText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="380" />
    </Grid>
    <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,16" />
  </StackPanel>
</ui:FluentWindow>

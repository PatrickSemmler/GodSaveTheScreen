<ui:FluentWindow x:Class="GodSaveTheScreen.App.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:GodSaveTheScreen.App.Localization"
                 xmlns:pages="clr-namespace:GodSaveTheScreen.App.Views.Settings"
                 Title="{l:Loc Settings_Title}"
                 Width="900"
                 Height="640"
                 MinWidth="720"
                 MinHeight="480"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="{l:Loc Settings_Title}" />
    <ui:NavigationView x:Name="Navigation"
                       Grid.Row="1"
                       PaneDisplayMode="Left"
                       IsBackButtonVisible="Collapsed"
                       IsPaneToggleVisible="False"
                       OpenPaneLength="200">
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Content="{l:Loc Settings_General}" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type pages:GeneralPage}" />
        <ui:NavigationViewItem Content="{l:Loc Settings_Capture}" Icon="{ui:SymbolIcon Camera24}" TargetPageType="{x:Type pages:CapturePage}" />
        <ui:NavigationViewItem Content="{l:Loc Settings_PostCapture}" Icon="{ui:SymbolIcon Save24}" TargetPageType="{x:Type pages:PostCapturePage}" />
        <ui:NavigationViewItem Content="{l:Loc Settings_Hotkeys}" Icon="{ui:SymbolIcon Keyboard24}" TargetPageType="{x:Type pages:HotkeysPage}" />
        <ui:NavigationViewItem Content="{l:Loc Settings_About}" Icon="{ui:SymbolIcon Info24}" TargetPageType="{x:Type pages:AboutPage}" />
      </ui:NavigationView.MenuItems>
    </ui:NavigationView>
  </Grid>
</ui:FluentWindow>

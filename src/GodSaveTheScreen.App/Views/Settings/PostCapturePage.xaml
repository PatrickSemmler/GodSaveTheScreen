<Page x:Class="GodSaveTheScreen.App.Views.Settings.PostCapturePage"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:GodSaveTheScreen.App.Localization"
      Title="PostCapturePage">
  <Page.Resources>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,0,0,8" /></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Margin" Value="0,8,0,4" /></Style>
  </Page.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,8,24,24" MaxWidth="640" HorizontalAlignment="Left">
      <ui:TextBlock Text="{l:Loc Settings_PostCapture}" FontTypography="Subtitle" Margin="0,0,0,12" />
      <CheckBox Content="{l:Loc Settings_OpenEditor}" IsChecked="True" IsEnabled="False" />
      <CheckBox Content="{l:Loc Settings_CopyClipboard}" IsChecked="{Binding CopyToClipboard}" />
      <CheckBox Content="{l:Loc Settings_AutoSave}" IsChecked="{Binding AutoSave}" />
      <StackPanel IsEnabled="{Binding AutoSave}" Margin="24,0,0,0">
        <TextBlock Style="{StaticResource Label}" Text="{l:Loc Settings_Directory}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Text="{Binding AutoSaveDirectory, UpdateSourceTrigger=LostFocus}" />
          <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="{l:Loc Settings_Browse}" Command="{Binding BrowseAutoSaveDirectoryCommand}" />
        </Grid>
        <TextBlock Style="{StaticResource Label}" Text="{l:Loc Settings_Pattern}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Text="{Binding FileNamePattern, UpdateSourceTrigger=LostFocus}" />
          <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="{l:Loc Settings_Reset}" Command="{Binding ResetFileNamePatternCommand}" />
        </Grid>
        <TextBlock Text="{l:Loc Settings_PatternHelp}" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
        <TextBlock Style="{StaticResource Label}" Text="{l:Loc Settings_Format}" />
        <ComboBox ItemsSource="{Binding Formats}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding AutoSaveFormat}" MinWidth="160" HorizontalAlignment="Left" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>

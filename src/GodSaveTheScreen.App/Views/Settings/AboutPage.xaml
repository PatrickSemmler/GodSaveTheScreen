<Page x:Class="GodSaveTheScreen.App.Views.Settings.AboutPage"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:GodSaveTheScreen.App.Localization"
      Title="AboutPage">
  <Page.Resources>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Margin" Value="0,8,0,4" /></Style>
  </Page.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,8,24,24" MaxWidth="640" HorizontalAlignment="Left">
      <ui:TextBlock Text="{l:Loc Settings_About}" FontTypography="Subtitle" Margin="0,0,0,12" />
      <TextBlock>
        <Run Text="{l:Loc App_Name}" FontWeight="SemiBold" />
        <Run Text="{Binding Version, Mode=OneWay}" />
      </TextBlock>
      <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
        <TextBlock Text="{l:Loc Settings_DevelopedBy}" />
        <TextBlock Text="{Binding Author, Mode=OneWay}" Margin="4,0,0,0" />
      </StackPanel>
      <TextBlock Text="{Binding Copyright, Mode=OneWay}" Margin="0,2,0,0" />
      <TextBlock Style="{StaticResource Label}" Text="{l:Loc Settings_ProjectPage}" />
      <TextBlock TextWrapping="Wrap">
        <Hyperlink Command="{Binding OpenRepositoryCommand}" ToolTip="{Binding RepositoryUrl, Mode=OneWay}"
                   AutomationProperties.Name="{l:Loc Settings_ProjectPage}">
          <Run Text="{Binding RepositoryUrl, Mode=OneWay}" />
        </Hyperlink>
      </TextBlock>
      <TextBlock Style="{StaticResource Label}" Text="{l:Loc Settings_DataFolder}" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding DataDirectory}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="{l:Loc Settings_Open}" Command="{Binding OpenDataDirectoryCommand}" />
      </Grid>
      <TextBlock Style="{StaticResource Label}" Text="{l:Loc Settings_LogFolder}" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding LogDirectory}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="{l:Loc Settings_Open}" Command="{Binding OpenLogDirectoryCommand}" />
      </Grid>
      <TextBlock Style="{StaticResource Label}" Text="{l:Loc Settings_Licenses}" Margin="0,16,0,4" />
      <TextBlock Text="{l:Loc Settings_LicenseInfo}" TextWrapping="Wrap" />
      <ui:Button Margin="0,8,0,0" Icon="{ui:SymbolIcon DocumentText24}" Content="{l:Loc Settings_ShowLicense}" Command="{Binding ShowLicenseCommand}" />
    </StackPanel>
  </ScrollViewer>
</Page>

<Page x:Class="GodSaveTheScreen.App.Views.Settings.GeneralPage"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:GodSaveTheScreen.App.Localization"
      Title="GeneralPage">
  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Margin" Value="0,0,0,8" /></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Margin" Value="0,8,0,4" /></Style>
  </Page.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,8,24,24" MaxWidth="640" HorizontalAlignment="Left">
      <ui:TextBlock Text="{l:Loc Settings_General}" FontTypography="Subtitle" Margin="0,0,0,12" />
      <TextBlock Style="{StaticResource Label}" Text="{l:Loc Settings_Language}" />
      <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Language}" MinWidth="220" HorizontalAlignment="Left" />
      <TextBlock Text="{l:Loc Settings_RestartHint}" Foreground="OrangeRed" Margin="0,4,0,0" Visibility="{Binding RestartRequired, Converter={StaticResource BoolToVis}}" />
      <TextBlock Style="{StaticResource Label}" Text="{l:Loc Settings_Theme}" />
      <ComboBox ItemsSource="{Binding Themes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Theme}" MinWidth="220" HorizontalAlignment="Left" />
      <TextBlock Style="{StaticResource Label}" Text="{l:Loc Settings_TrayClick}" />
      <ComboBox ItemsSource="{Binding TrayActions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding TrayClickAction}" MinWidth="220" HorizontalAlignment="Left" Margin="0,0,0,16" />
      <CheckBox Content="{l:Loc Settings_Autostart}" IsChecked="{Binding Autostart}" />
      <CheckBox Content="{l:Loc Settings_StartInTray}" IsChecked="{Binding StartInTray}" />
    </StackPanel>
  </ScrollViewer>
</Page>

<ui:FluentWindow x:Class="GodSaveTheScreen.App.Views.FramePickerDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:GodSaveTheScreen.App.Localization"
                 Width="560"
                 Height="520"
                 MinWidth="360"
                 MinHeight="320"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
  <DockPanel>
    <ui:TitleBar x:Name="Bar" DockPanel.Dock="Top" ShowMinimize="False" ShowMaximize="False" />
    <TextBlock x:Name="PromptText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="24,8,24,8" />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,8,24,16">
      <ui:Button x:Name="OkButton" Content="{l:Loc Dialog_Ok}" MinWidth="88" Margin="8,0,0,0" Appearance="Primary" IsDefault="True" Click="OnOk" />
      <ui:Button Content="{l:Loc Dialog_Cancel}" MinWidth="88" Margin="8,0,0,0" IsCancel="True" Click="OnCancel" />
    </StackPanel>
    <ListBox x:Name="Frames"
             Margin="24,0,24,0"
             SelectionMode="Single"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             VirtualizingPanel.IsVirtualizing="True"
             MouseDoubleClick="OnFrameDoubleClick"
             AutomationProperties.Name="{l:Loc Image_Frames}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Width="112" Margin="4" AutomationProperties.Name="{Binding Label}">
            <Border Height="96" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4">
              <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.8" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</ui:FluentWindow>

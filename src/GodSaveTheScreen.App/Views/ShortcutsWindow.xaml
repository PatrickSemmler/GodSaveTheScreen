<ui:FluentWindow x:Class="GodSaveTheScreen.App.Views.ShortcutsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:GodSaveTheScreen.App.Localization"
                 Title="{l:Loc Shortcuts_Title}"
                 Width="520"
                 Height="640"
                 MinWidth="400"
                 MinHeight="360"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 PreviewKeyDown="OnPreviewKeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="{l:Loc Shortcuts_Title}" ShowMinimize="False" ShowMaximize="False" />
    <ui:TextBox Grid.Row="1" Margin="16,4,16,8" PlaceholderText="{l:Loc Shortcuts_Filter}"
                Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.Name="{l:Loc Shortcuts_Filter}" />
    <ListBox Grid.Row="2"
             Margin="16,0,16,16"
             ItemsSource="{Binding View}"
             HorizontalContentAlignment="Stretch"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             AutomationProperties.Name="{l:Loc Shortcuts_Title}">
      <ListBox.GroupStyle>
        <GroupStyle>
          <GroupStyle.HeaderTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,12,0,4" />
            </DataTemplate>
          </GroupStyle.HeaderTemplate>
        </GroupStyle>
      </ListBox.GroupStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="4,2" AutomationProperties.Name="{Binding Automation}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            <Border Grid.Column="1" Padding="8,1" CornerRadius="4" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
              <TextBlock Text="{Binding Keys}" FontFamily="Consolas" />
            </Border>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</ui:FluentWindow>

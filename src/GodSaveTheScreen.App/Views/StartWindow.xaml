<ui:FluentWindow x:Class="GodSaveTheScreen.App.Views.StartWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:GodSaveTheScreen.App.Localization"
                 Title="{l:Loc Start_Title}"
                 Width="760"
                 SizeToContent="Height"
                 MaxHeight="760"
                 ResizeMode="CanMinimize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 AllowDrop="True"
                 DragOver="OnDragOver"
                 Drop="OnDrop"
                 PreviewKeyDown="OnPreviewKeyDown">
  <StackPanel>
    <StackPanel.Resources>
      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </StackPanel.Resources>
    <ui:TitleBar Title="{l:Loc Start_Title}" />
    <Grid Margin="16,8,16,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ui:Button Grid.Column="0"
                 Appearance="Primary"
                 Icon="{ui:SymbolIcon Add24}"
                 Content="{l:Loc Start_New}"
                 Command="{Binding NewCaptureCommand}"
                 VerticalAlignment="Center" />
      <ComboBox Grid.Column="1"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                ItemsSource="{Binding Modes}"
                SelectedItem="{Binding SelectedMode}"
                DisplayMemberPath="Label"
                AutomationProperties.Name="{l:Loc Start_Mode}" />
      <ui:Button Grid.Column="2"
                 Margin="8,0,0,0"
                 Icon="{ui:SymbolIcon FolderOpen24}"
                 Content="{l:Loc Start_Open}"
                 Command="{Binding OpenCommand}" />
      <ui:Button Grid.Column="3"
                 Margin="8,0,0,0"
                 Icon="{ui:SymbolIcon ClipboardPaste24}"
                 Content="{l:Loc Start_FromClipboard}"
                 Command="{Binding OpenFromClipboardCommand}" />
      <ui:Button Grid.Column="4"
                 Margin="8,0,0,0"
                 Icon="{ui:SymbolIcon Settings24}"
                 Content="{l:Loc Start_Settings}"
                 Command="{Binding OpenSettingsCommand}" />
      <ui:Button Grid.Column="5"
                 Margin="8,0,0,0"
                 Icon="{ui:SymbolIcon Keyboard24}"
                 Command="{Binding ShowShortcutsCommand}"
                 ToolTip="{l:Loc Shortcuts_Tip}"
                 AutomationProperties.Name="{l:Loc Shortcuts_Title}" />
      <ui:Button Grid.Column="6"
                 Margin="8,0,0,0"
                 Icon="{ui:SymbolIcon QuestionCircle24}"
                 Command="{Binding ShowHelpCommand}"
                 ToolTip="{l:Loc Help_Tip}"
                 AutomationProperties.Name="{l:Loc Help_Title}" />
    </Grid>
    <StackPanel Orientation="Horizontal" Margin="16,0,16,16">
      <TextBlock Text="{l:Loc Timer_Label}" VerticalAlignment="Center" />
      <ComboBox Margin="8,0,0,0"
                MinWidth="170"
                ItemsSource="{Binding TimerOptions}"
                SelectedItem="{Binding SelectedTimer}"
                DisplayMemberPath="Label"
                AutomationProperties.Name="{l:Loc Timer_Label}" />
      <ui:NumberBox Margin="8,0,0,0"
                    Width="130"
                    Minimum="0"
                    Maximum="3600"
                    SmallChange="1"
                    LargeChange="10"
                    MaxDecimalPlaces="0"
                    ClearButtonEnabled="False"
                    PlaceholderText="{l:Loc Timer_Seconds}"
                    Value="{Binding CustomSecondsInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="{l:Loc Timer_Seconds}">
        <ui:NumberBox.Style>
          <Style TargetType="ui:NumberBox" BasedOn="{StaticResource {x:Type ui:NumberBox}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsCustomTimer}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ui:NumberBox.Style>
      </ui:NumberBox>
    </StackPanel>
    <!-- Zuletzt verwendet -->
    <Grid Margin="16,0,16,16" Visibility="{Binding HasRecents, Converter={StaticResource BoolToVisibility}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DockPanel>
        <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Content="{l:Loc Recent_Clear}" Command="{Binding ClearRecentsCommand}" Padding="8,2" />
        <TextBlock Text="{l:Loc Recent_Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
      <ListBox x:Name="RecentList"
               Grid.Row="1"
               Margin="0,6,0,0"
               MaxHeight="300"
               ItemsSource="{Binding RecentItems}"
               HorizontalContentAlignment="Stretch"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               MouseDoubleClick="OnRecentDoubleClick"
               KeyDown="OnRecentKeyDown"
               AutomationProperties.Name="{l:Loc Recent_Title}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="2" ToolTip="{Binding Path}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Width="80" Height="52" CornerRadius="3" Background="{DynamicResource ControlFillColorSecondaryBrush}" ClipToBounds="True">
                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Directory}" TextTrimming="CharacterEllipsis" Opacity="0.65" FontSize="11" />
                <TextBlock Text="{l:Loc Recent_Missing}" Foreground="{DynamicResource SystemFillColorCautionBrush}" FontSize="11"
                           Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
              <ui:Button Grid.Column="2" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss16}" VerticalAlignment="Center"
                         Command="{Binding DataContext.RemoveRecentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                         CommandParameter="{Binding}"
                         ToolTip="{l:Loc Recent_Remove}"
                         AutomationProperties.Name="{l:Loc Recent_Remove}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsMissing}" Value="True">
                <Setter Property="Opacity" Value="0.5" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ListBox.ItemContainerStyle>
      </ListBox>
    </Grid>
  </StackPanel>
</ui:FluentWindow>

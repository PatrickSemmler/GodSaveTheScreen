<Window x:Class="GodSaveTheScreen.App.Capture.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GodSaveTheScreen.App.Localization"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="False"
        Background="Black"
        WindowStartupLocation="Manual"
        Left="0" Top="0" Width="100" Height="100"
        Cursor="Cross"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Focusable="True">
  <Canvas x:Name="Root" ClipToBounds="True" Background="Transparent">
    <Image x:Name="BackgroundImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False" />
    <Path x:Name="Dim" Fill="#99000000" IsHitTestVisible="False" />
    <Polygon x:Name="FreeformShape" Stroke="White" StrokeThickness="1.5" StrokeDashArray="4 3" Fill="Transparent"
             Visibility="Collapsed" IsHitTestVisible="False" />
    <Rectangle x:Name="SelectionBorder" Stroke="White" StrokeThickness="1" Visibility="Collapsed" IsHitTestVisible="False" />
    <Line x:Name="CrossHorizontal" Stroke="#B0FFFFFF" StrokeThickness="1" IsHitTestVisible="False" />
    <Line x:Name="CrossVertical" Stroke="#B0FFFFFF" StrokeThickness="1" IsHitTestVisible="False" />
    <Border x:Name="WindowBadge" Background="#CC0B5CAD" CornerRadius="3" Padding="6,2" MaxWidth="480" Visibility="Collapsed" IsHitTestVisible="False">
      <TextBlock x:Name="WindowBadgeText" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis" />
    </Border>
    <Border x:Name="SizeLabel" Background="#CC000000" CornerRadius="3" Padding="6,2" Visibility="Collapsed" IsHitTestVisible="False">
      <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" />
    </Border>
    <Border x:Name="Magnifier" Background="#E6000000" BorderBrush="White" BorderThickness="1" Padding="4"
            Width="130" Visibility="Collapsed" IsHitTestVisible="False">
      <StackPanel>
        <Canvas Width="120" Height="120">
          <Image x:Name="MagnifierImage" Width="120" Height="120" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
          <Rectangle x:Name="MagnifierMarker" Width="8" Height="8" Stroke="Red" StrokeThickness="1" />
        </Canvas>
        <TextBlock x:Name="ColorText" Foreground="White" FontFamily="Consolas" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
      </StackPanel>
    </Border>
    <Border x:Name="Hint" Background="#CC000000" CornerRadius="4" Padding="10,4" IsHitTestVisible="False">
      <TextBlock x:Name="HintText" Text="{l:Loc Overlay_Hint}" Foreground="White" FontSize="13" />
    </Border>
  </Canvas>
</Window>

<Window x:Class="GodSaveTheScreen.App.Capture.ScrollCaptureBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GodSaveTheScreen.App.Localization"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        Width="320" Height="252"
        WindowStartupLocation="Manual"
        Focusable="False"
        AutomationProperties.Name="{l:Loc Scroll_BarName}">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Margin" Value="0,0,16,0" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#33FFFFFF" />
      <Setter Property="BorderBrush" Value="#66FFFFFF" />
      <Setter Property="Padding" Value="16,6" />
      <Setter Property="MinWidth" Value="96" />
    </Style>
  </Window.Resources>
  <Border Background="#F0202020" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock x:Name="Status" Grid.Row="0" TextWrapping="Wrap" MinHeight="40" Margin="0,0,0,8" />
      <Grid Grid.Row="1" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="72" Background="#22FFFFFF" CornerRadius="2" Margin="0,0,12,0">
          <Image x:Name="Preview" Stretch="Uniform" VerticalAlignment="Top" AutomationProperties.Name="{l:Loc Scroll_PreviewName}" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="HeightText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
          <ProgressBar x:Name="Bar" Minimum="0" Maximum="1" Height="6" />
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
        <RadioButton x:Name="AutoRadio" GroupName="Mode" Content="{l:Loc Scroll_ModeAuto}" IsChecked="True" Checked="OnModeChecked" />
        <RadioButton x:Name="ManualRadio" GroupName="Mode" Content="{l:Loc Scroll_ModeManual}" Checked="OnModeChecked" />
      </StackPanel>
      <CheckBox x:Name="ToStart" Grid.Row="3" Content="{l:Loc Scroll_ToStart}" Margin="0,0,0,10" Click="OnToStartClick" />
      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{l:Loc Scroll_Finish}" IsDefault="False" Margin="0,0,8,0" Click="OnFinishClick" />
        <Button Content="{l:Loc Scroll_Cancel}" Click="OnCancelClick" />
      </StackPanel>
    </Grid>
  </Border>
</Window>

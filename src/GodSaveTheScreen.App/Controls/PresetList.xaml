<UserControl x:Class="GodSaveTheScreen.App.Controls.PresetList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:GodSaveTheScreen.App.Localization">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="PresetButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Padding" Value="0" />
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="{l:Loc Text_Presets}" Margin="0,14,0,4" Opacity="0.75" />
    <ListBox x:Name="List"
             ItemsSource="{Binding Items}"
             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
             MaxHeight="190"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             PreviewKeyDown="OnListKeyDown"
             AutomationProperties.Name="{l:Loc Text_Presets}">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <EventSetter Event="MouseLeftButtonUp" Handler="OnItemClick" />
          <Setter Property="Padding" Value="6,4" />
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="38" Height="22" CornerRadius="4" BorderThickness="2"
                    Background="{Binding FillBrush}" BorderBrush="{Binding LineBrush}">
              <TextBlock Text="{l:Loc Preset_Sample}" FontWeight="SemiBold" FontSize="11"
                         Foreground="{Binding LineBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding ShowSample, Converter={StaticResource BoolToVisibility}}" />
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Text="{l:Loc Preset_Empty}" TextWrapping="Wrap" Opacity="0.6" Margin="0,4,0,0"
               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
      <ui:Button Style="{StaticResource PresetButton}" Command="{Binding SaveAsPresetCommand}"
                 ToolTip="{l:Loc Preset_Save}" AutomationProperties.Name="{l:Loc Preset_Save}">
        <ui:SymbolIcon Symbol="SaveEdit24" />
      </ui:Button>
      <ui:Button Style="{StaticResource PresetButton}" Command="{Binding RenameCommand}"
                 ToolTip="{l:Loc Preset_Rename}" AutomationProperties.Name="{l:Loc Preset_Rename}">
        <ui:SymbolIcon Symbol="Rename24" />
      </ui:Button>
      <ui:Button Style="{StaticResource PresetButton}" Command="{Binding DeleteCommand}"
                 ToolTip="{l:Loc Preset_Delete}" AutomationProperties.Name="{l:Loc Preset_Delete}">
        <ui:SymbolIcon Symbol="Delete24" />
      </ui:Button>
      <ui:Button Style="{StaticResource PresetButton}" Command="{Binding RestoreDefaultsCommand}"
                 ToolTip="{l:Loc Preset_Restore}" AutomationProperties.Name="{l:Loc Preset_Restore}"
                 Visibility="{Binding HasDefaults, Converter={StaticResource BoolToVisibility}}">
        <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
      </ui:Button>
    </StackPanel>
  </StackPanel>
</UserControl>

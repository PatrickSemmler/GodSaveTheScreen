                  <controls:ColorButton Style="{StaticResource CompactColor}" SelectedColor="{Binding TextColor, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="{l:Loc Text_Background}" Style="{StaticResource FieldLabel}" Width="56" ToolTip="{l:Loc Text_Background}" />
                  <controls:ColorButton Style="{StaticResource CompactColor}" SelectedColor="{Binding BackgroundColor, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="{l:Loc Callout_Padding}" Style="{StaticResource FieldLabel}" ToolTip="{l:Loc Callout_Padding}" />
                  <controls:SpinBox Minimum="0" Maximum="200" SmallChange="1" LargeChange="5" Unit="px"
                                    Value="{Binding Padding}" AutomationProperties.Name="{l:Loc Callout_Padding}" />
                </StackPanel>
              </Grid>
            </controls:PanelSection>

            <controls:PanelSection Header="{l:Loc Section_Glow}" SectionKey="Glow" DefaultExpanded="False" HasSwitch="True"
                                   IsOn="{Binding IsGlowOn}">
              <controls:PanelSection.Summary>
                <StackPanel Orientation="Horizontal">
                  <Border Style="{StaticResource SummarySwatch}" Background="{Binding BorderColor, Converter={StaticResource ColorBrush}}" />
                  <TextBlock Style="{StaticResource SummaryText}" Text="{Binding BorderThickness, StringFormat={}{0:0.#} px}" />
                </StackPanel>
              </controls:PanelSection.Summary>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{l:Loc Field_Color}" Style="{StaticResource FieldLabel}" />
                  <controls:ColorButton Style="{StaticResource CompactColor}" SelectedColor="{Binding BorderColor, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="{l:Loc Field_Width}" Style="{StaticResource FieldLabel}" />
                  <controls:SpinBox Minimum="0" Maximum="50" SmallChange="0.5" LargeChange="2" Decimals="1" Unit="px"
                                    Value="{Binding BorderThickness}" AutomationProperties.Name="{l:Loc Callout_GlowWidth}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="{l:Loc Field_Blur}" Style="{StaticResource FieldLabel}" />
                  <controls:SpinBox Minimum="0" Maximum="50" SmallChange="1" LargeChange="5" Decimals="1"
                                    Value="{Binding BorderBlur}" AutomationProperties.Name="{l:Loc Callout_GlowBlur}" />
                </StackPanel>
              </Grid>
            </controls:PanelSection>

            <StackPanel Visibility="{Binding ShowDefaults, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{l:Loc Props_Opacity}" Style="{StaticResource FieldLabel}" Margin="0,4,0,3" />
              <DockPanel>
                <controls:SpinBox DockPanel.Dock="Right" Style="{StaticResource SliderSpin}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" Unit="%"
                                  Value="{Binding DefaultOpacityPercent}" AutomationProperties.Name="{l:Loc Props_Opacity}" />
                <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                        Value="{Binding DefaultOpacityValue, Mode=TwoWay}"
                        AutomationProperties.Name="{l:Loc Props_Opacity}" />
              </DockPanel>
            </StackPanel>
          </StackPanel>

          <!-- Formen, Linien, Freihand -->
          <StackPanel DataContext="{Binding Properties}" Visibility="{Binding IsApplicable, Converter={StaticResource BoolToVisibility}}">
            <controls:PanelSection Header="{l:Loc Section_Style}" SectionKey="Style">
              <controls:PanelSection.Summary>
                <StackPanel Orientation="Horizontal">
                  <Border Style="{StaticResource SummarySwatch}" Background="{Binding StrokeColor, Converter={StaticResource ColorBrush}}" />
                  <TextBlock Style="{StaticResource SummaryText}" Text="{Binding Thickness, StringFormat={}{0:0.#} px}" />
                </StackPanel>
              </controls:PanelSection.Summary>
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{l:Loc Props_StrokeColor}" Style="{StaticResource FieldLabel}" Width="80" HorizontalAlignment="Left" />
                    <controls:ColorButton Style="{StaticResource CompactColor}" SelectedColor="{Binding StrokeColor, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Visibility="{Binding ShowFill, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{l:Loc Props_FillColor}" Style="{StaticResource FieldLabel}" Width="80" HorizontalAlignment="Left" />
                    <controls:ColorButton Style="{StaticResource CompactColor}" SelectedColor="{Binding FillColor, Mode=TwoWay}" />
                  </StackPanel>
                </Grid>

                <TextBlock Text="{l:Loc Props_Thickness}" Style="{StaticResource FieldLabel}" />
                <DockPanel>
                  <controls:SpinBox DockPanel.Dock="Right" Style="{StaticResource SliderSpin}" Minimum="0" Maximum="100" SmallChange="0.5" LargeChange="5" Decimals="1" Unit="px"
                                    Value="{Binding Thickness}" AutomationProperties.Name="{l:Loc Props_Thickness}" />
                  <Slider Minimum="0" Maximum="40" SmallChange="0.5" LargeChange="2" VerticalAlignment="Center"
                          Value="{Binding ThicknessValue, Mode=TwoWay}"
                          AutomationProperties.Name="{l:Loc Props_Thickness}" />
                </DockPanel>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Visibility="{Binding ShowDash, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{l:Loc Props_Dash}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding DashChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Dash, Mode=TwoWay}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="{l:Loc Props_Dash}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Width="84" Margin="8,0,0,0" Visibility="{Binding ShowCornerRadius, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{l:Loc Props_CornerRadius}" Style="{StaticResource FieldLabel}" ToolTip="{l:Loc Props_CornerRadius}" />
                    <controls:SpinBox Minimum="0" Maximum="500" SmallChange="1" LargeChange="10" Unit="px"
                                      Value="{Binding CornerRadius}" AutomationProperties.Name="{l:Loc Props_CornerRadius}" />
                  </StackPanel>
                </Grid>

                <Grid Visibility="{Binding ShowCaps, Converter={StaticResource BoolToVisibility}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{l:Loc Props_StartCap}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding CapChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding StartCap, Mode=TwoWay}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="{l:Loc Props_StartCap}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:Loc Props_EndCap}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding CapChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding EndCap, Mode=TwoWay}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="{l:Loc Props_EndCap}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </controls:PanelSection>

            <!-- Kontur nur für Linie/Pfeil -->
            <controls:PanelSection Header="{l:Loc Text_Outline}" SectionKey="Outline" DefaultExpanded="False" HasSwitch="True"
                                   IsOn="{Binding IsOutlineOn}"
                                   Visibility="{Binding ShowCaps, Converter={StaticResource BoolToVisibility}}">
              <controls:PanelSection.Summary>
                <StackPanel Orientation="Horizontal">
                  <Border Style="{StaticResource SummarySwatch}" Background="{Binding OutlineColor, Converter={StaticResource ColorBrush}}" />
                  <TextBlock Style="{StaticResource SummaryText}" Text="{Binding OutlineThickness, StringFormat={}{0:0.#} px}" />
                </StackPanel>
              </controls:PanelSection.Summary>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{l:Loc Field_Color}" Style="{StaticResource FieldLabel}" />
                  <controls:ColorButton Style="{StaticResource CompactColor}" SelectedColor="{Binding OutlineColor, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="{l:Loc Field_Width}" Style="{StaticResource FieldLabel}" />
                  <controls:SpinBox Minimum="0" Maximum="50" SmallChange="0.5" LargeChange="2" Decimals="1" Unit="px"
                                    Value="{Binding OutlineThickness}" AutomationProperties.Name="{l:Loc Text_OutlineWidth}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="{l:Loc Field_Blur}" Style="{StaticResource FieldLabel}" />
                  <controls:SpinBox Minimum="0" Maximum="50" SmallChange="1" LargeChange="5" Decimals="1"
                                    Value="{Binding OutlineBlur}" AutomationProperties.Name="{l:Loc Text_OutlineBlur}" />
                </StackPanel>
              </Grid>
            </controls:PanelSection>
          </StackPanel>

          <!-- Bild: Größe, Drehung, Spiegelung, Kontur bzw. Vorgaben neuer Bilder -->
          <StackPanel DataContext="{Binding ImageProperties}" Visibility="{Binding IsApplicable, Converter={StaticResource BoolToVisibility}}">
            <ui:Button Content="{l:Loc Image_InsertButton}" Icon="{ui:SymbolIcon ImageAdd24}" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                       Command="{Binding InsertCommand}" Visibility="{Binding ShowDefaults, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="{l:Loc Image_Placeholder}" TextWrapping="Wrap" Foreground="#F5A623" Margin="0,0,0,8"
                       Visibility="{Binding HasPlaceholder, Converter={StaticResource BoolToVisibility}}" />

            <controls:PanelSection Header="{l:Loc Section_Geometry}" SectionKey="Geometry"
                                   Visibility="{Binding HasImages, Converter={StaticResource BoolToVisibility}}">
              <controls:PanelSection.Summary>
                <TextBlock Style="{StaticResource SummaryText}">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0:0} × {1:0}">
                      <Binding Path="Width" />
                      <Binding Path="Height" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </controls:PanelSection.Summary>
              <StackPanel>
                <TextBlock Text="{l:Loc Image_Size}" Style="{StaticResource FieldLabel}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <controls:SpinBox Minimum="4" Maximum="100000" SmallChange="1" LargeChange="10" Unit="px"
                                    Value="{Binding Width}" AutomationProperties.Name="{l:Loc Emoji_Width}" ToolTip="{l:Loc Emoji_Width}" />
                  <TextBlock Grid.Column="1" Text="×" Margin="6,0" VerticalAlignment="Center" />
                  <controls:SpinBox Grid.Column="2" Minimum="4" Maximum="100000" SmallChange="1" LargeChange="10" Unit="px"
                                    Value="{Binding Height}" AutomationProperties.Name="{l:Loc Emoji_Height}" ToolTip="{l:Loc Emoji_Height}" />
                </Grid>
                <CheckBox Content="{l:Loc Image_KeepAspect}" IsChecked="{Binding KeepAspectRatio, Mode=TwoWay}" Margin="0,8,0,0" />
                <Grid Margin="0,6,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ui:Button Content="{l:Loc Image_ResetSize}" HorizontalAlignment="Stretch" Margin="0,0,3,0" Command="{Binding ResetSizeCommand}" />
                  <ui:Button Grid.Column="1" Content="{l:Loc Image_ResetAspect}" HorizontalAlignment="Stretch" Margin="3,0,0,0" Command="{Binding ResetAspectCommand}" />
                </Grid>

                <TextBlock Text="{l:Loc Props_Rotation}" Style="{StaticResource FieldLabel}" />
                <DockPanel>
                  <ui:Button DockPanel.Dock="Right" Style="{StaticResource ResetButton}" Icon="{ui:SymbolIcon ArrowReset24}" AutomationProperties.Name="{l:Loc Emoji_ResetRotation}" Command="{Binding ResetRotationCommand}" />
                  <controls:SpinBox DockPanel.Dock="Right" Style="{StaticResource SliderSpin}" Minimum="-180" Maximum="180" SmallChange="1" LargeChange="15" Decimals="1" Unit="°"
                                    Value="{Binding Rotation}" AutomationProperties.Name="{l:Loc Props_Rotation}" />
                  <Slider Minimum="-180" Maximum="180" SmallChange="1" LargeChange="15" VerticalAlignment="Center"
                          Value="{Binding RotationValue, Mode=TwoWay}"
                          AutomationProperties.Name="{l:Loc Props_Rotation}" />
                </DockPanel>

                <TextBlock Text="{l:Loc Emoji_Flip}" Style="{StaticResource FieldLabel}" />
                <StackPanel Orientation="Horizontal">
                  <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding FlipHorizontal, Mode=TwoWay}" ToolTip="{l:Loc Emoji_FlipH}" AutomationProperties.Name="{l:Loc Emoji_FlipH}">
                    <ui:SymbolIcon Symbol="FlipHorizontal24" />
                  </ToggleButton>
                  <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding FlipVertical, Mode=TwoWay}" ToolTip="{l:Loc Emoji_FlipV}" AutomationProperties.Name="{l:Loc Emoji_FlipV}">
                    <ui:SymbolIcon Symbol="FlipVertical24" />
                  </ToggleButton>
                </StackPanel>
              </StackPanel>
            </controls:PanelSection>

            <controls:PanelSection Header="{l:Loc Image_Outline}" SectionKey="Outline" DefaultExpanded="False" HasSwitch="True"
                                   IsOn="{Binding IsOutlineOn}">
              <controls:PanelSection.Summary>
                <StackPanel Orientation="Horizontal">
                  <Border Style="{StaticResource SummarySwatch}" Background="{Binding OutlineColor, Converter={StaticResource ColorBrush}}" />
                  <TextBlock Style="{StaticResource SummaryText}" Text="{Binding OutlineThickness, StringFormat={}{0:0.#} px}" />
                </StackPanel>
              </controls:PanelSection.Summary>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{l:Loc Field_Color}" Style="{StaticResource FieldLabel}" />
                  <controls:ColorButton Style="{StaticResource CompactColor}" SelectedColor="{Binding OutlineColor, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="{l:Loc Field_Width}" Style="{StaticResource FieldLabel}" />
                  <controls:SpinBox Minimum="0" Maximum="50" SmallChange="0.5" LargeChange="2" Decimals="1" Unit="px"
                                    Value="{Binding OutlineThickness}" AutomationProperties.Name="{l:Loc Image_OutlineWidth}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="{l:Loc Field_Blur}" Style="{StaticResource FieldLabel}" />
                  <controls:SpinBox Minimum="0" Maximum="50" SmallChange="1" LargeChange="5" Decimals="1"
                                    Value="{Binding OutlineBlur}" AutomationProperties.Name="{l:Loc Image_OutlineBlur}" />
                </StackPanel>
              </Grid>
            </controls:PanelSection>

            <StackPanel Visibility="{Binding ShowDefaults, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{l:Loc Props_Opacity}" Style="{StaticResource FieldLabel}" Margin="0,4,0,3" />
              <DockPanel>
                <controls:SpinBox DockPanel.Dock="Right" Style="{StaticResource SliderSpin}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" Unit="%"
                                  Value="{Binding DefaultOpacityPercent}" AutomationProperties.Name="{l:Loc Props_Opacity}" />
                <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                        Value="{Binding DefaultOpacityValue, Mode=TwoWay}"
                        AutomationProperties.Name="{l:Loc Props_Opacity}" />
              </DockPanel>
            </StackPanel>
          </StackPanel>

          <!-- Drehung ausgewählter Formen, Polygone, Freihandstriche und Texte (keine Werkzeug-Vorgabe) -->
          <controls:PanelSection DataContext="{Binding RotationProperties}" Header="{l:Loc Section_Rotation}" SectionKey="Rotation" DefaultExpanded="False"
                                 Visibility="{Binding IsApplicable, Converter={StaticResource BoolToVisibility}}">
            <controls:PanelSection.Summary>
              <TextBlock Style="{StaticResource SummaryText}" Text="{Binding Rotation, StringFormat={}{0:0.#}°}" />
            </controls:PanelSection.Summary>
            <DockPanel Margin="0,8,0,0">
              <ui:Button DockPanel.Dock="Right" Style="{StaticResource ResetButton}" Icon="{ui:SymbolIcon ArrowReset24}" AutomationProperties.Name="{l:Loc Emoji_ResetRotation}" Command="{Binding ResetRotationCommand}" />
              <controls:SpinBox DockPanel.Dock="Right" Style="{StaticResource SliderSpin}" Minimum="-180" Maximum="180" SmallChange="1" LargeChange="15" Decimals="1" Unit="°"
                                Value="{Binding Rotation}" AutomationProperties.Name="{l:Loc Props_Rotation}" />
              <Slider Minimum="-180" Maximum="180" SmallChange="1" LargeChange="15" VerticalAlignment="Center"
                      Value="{Binding RotationValue, Mode=TwoWay}"
                      AutomationProperties.Name="{l:Loc Props_Rotation}" />
            </DockPanel>
          </controls:PanelSection>

          <!-- Schatten (Formen, Linien, Text, Marker, Emoji, Sprechblasen, Bilder) -->
          <controls:PanelSection DataContext="{Binding ShadowProperties}" Header="{l:Loc Section_Shadow}" SectionKey="Shadow" DefaultExpanded="False"
                                 HasSwitch="True" IsOn="{Binding IsShadowOn}"
                                 Visibility="{Binding IsApplicable, Converter={StaticResource BoolToVisibility}}">
            <controls:PanelSection.Summary>
              <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource SummarySwatch}" Background="{Binding ShadowColor, Converter={StaticResource ColorBrush}}" />
                <TextBlock Style="{StaticResource SummaryText}" Text="{Binding ShadowSize, StringFormat={}{0:0.#} px}" />
              </StackPanel>
            </controls:PanelSection.Summary>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{l:Loc Field_Color}" Style="{StaticResource FieldLabel}" />
                <controls:ColorButton Style="{StaticResource CompactColor}" SelectedColor="{Binding ShadowColor, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="{l:Loc Text_Size}" Style="{StaticResource FieldLabel}" />
                <controls:SpinBox Minimum="0" Maximum="200" SmallChange="1" LargeChange="5" Decimals="1" Unit="px"
                                  Value="{Binding ShadowSize}" AutomationProperties.Name="{l:Loc Shadow_Size}" />
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="{l:Loc Field_Blur}" Style="{StaticResource FieldLabel}" />
                <controls:SpinBox Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" Decimals="1"
                                  Value="{Binding ShadowBlur}" AutomationProperties.Name="{l:Loc Shadow_Blur}" />
              </StackPanel>
            </Grid>
          </controls:PanelSection>

          <!-- Deckkraft für alle Objekte -->
          <StackPanel DataContext="{Binding Properties}" Visibility="{Binding ShowOpacity, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{l:Loc Props_Opacity}" Style="{StaticResource FieldLabel}" Margin="0,4,0,3" />
            <DockPanel>
              <controls:SpinBox DockPanel.Dock="Right" Style="{StaticResource SliderSpin}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" Unit="%"
                                Value="{Binding OpacityPercent}" AutomationProperties.Name="{l:Loc Props_Opacity}" />
              <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                      Value="{Binding OpacityValue, Mode=TwoWay}"
                      AutomationProperties.Name="{l:Loc Props_Opacity}" />
            </DockPanel>
          </StackPanel>

          <!-- Werkzeug-Einstellungen auf die Standardwerte zurücksetzen -->
          <ui:Button Content="{l:Loc Props_ResetDefaults}" Icon="{ui:SymbolIcon ArrowReset24}" Margin="0,16,0,0" HorizontalAlignment="Stretch"
                     Command="{Binding ResetToolDefaultsCommand}" ToolTip="{l:Loc Props_ResetDefaultsTip}"
                     Visibility="{Binding CanResetToolDefaults, Converter={StaticResource BoolToVisibility}}" />

          <!-- Vorlagen des aktiven Werkzeugs -->
          <controls:PresetList DataContext="{Binding Presets}" Visibility="{Binding IsApplicable, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="{l:Loc Panel_Layers}">
      <controls:LayersPanel DataContext="{Binding Layers}" />
    </TabItem>
  </TabControl>
</UserControl>

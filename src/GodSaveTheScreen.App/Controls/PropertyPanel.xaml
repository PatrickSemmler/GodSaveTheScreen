                  <Button Content="{l:Loc Mask_Remove}" Command="{Binding RemoveAreaCommand}" HorizontalAlignment="Stretch" Margin="0,12,0,0" />
                  <UniformGrid Columns="2" Margin="0,6,0,0">
                    <Button Style="{StaticResource WrapButton}" Content="{l:Loc Mask_SelectAll}" Command="{Binding SelectAllCommand}" Margin="0,0,3,0" />
                    <Button Style="{StaticResource WrapButton}" Content="{l:Loc Mask_Deselect}" Command="{Binding DeselectCommand}" Margin="3,0,0,0" />
                  </UniformGrid>
                  <Button Content="{l:Loc Mask_Invert}" Command="{Binding InvertSelectionCommand}" HorizontalAlignment="Stretch" Margin="0,6,0,0" />
                </StackPanel>
              </controls:PanelSection>
            </StackPanel>

            <StackPanel Visibility="{Binding ShowEraser, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{l:Loc Mask_EraserHint}" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" />
              <controls:PanelSection Header="{l:Loc Section_Brush}" SectionKey="MaskBrush">
                <StackPanel>
                  <TextBlock Text="{l:Loc Mask_BrushSize}" Style="{StaticResource FieldLabel}" />
                  <DockPanel>
                    <controls:SpinBox DockPanel.Dock="Right" Style="{StaticResource SliderSpin}" Minimum="1" Maximum="500" SmallChange="1" LargeChange="10" Unit="px"
                                      Value="{Binding BrushSize}" AutomationProperties.Name="{l:Loc Mask_BrushSize}" />
                    <Slider Minimum="1" Maximum="500" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                            Value="{Binding BrushSize, Mode=TwoWay}"
                            AutomationProperties.Name="{l:Loc Mask_BrushSize}" />
                  </DockPanel>
                  <TextBlock Text="{l:Loc Mask_BrushHardness}" Style="{StaticResource FieldLabel}" />
                  <DockPanel>
                    <controls:SpinBox DockPanel.Dock="Right" Style="{StaticResource SliderSpin}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" Unit="%"
                                      Value="{Binding BrushHardness}" AutomationProperties.Name="{l:Loc Mask_BrushHardness}" />
                    <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                            Value="{Binding BrushHardness, Mode=TwoWay}"
                            AutomationProperties.Name="{l:Loc Mask_BrushHardness}" />
                  </DockPanel>
                </StackPanel>
              </controls:PanelSection>
            </StackPanel>

            <Button Content="{l:Loc Mask_CropToVisible}" Command="{Binding CropToVisibleCommand}" HorizontalAlignment="Stretch" Margin="0,6,0,0" />
            <Button Content="{l:Loc Mask_Reset}" Command="{Binding ResetMaskCommand}" HorizontalAlignment="Stretch" Margin="0,6,0,0" />
          </StackPanel>

          <!-- Emoji -->
          <StackPanel DataContext="{Binding EmojiProperties}" Visibility="{Binding IsApplicable, Converter={StaticResource BoolToVisibility}}">
            <controls:EmojiPicker Margin="0,0,0,8"
                                  DataContext="{Binding DataContext.EmojiPicker, RelativeSource={RelativeSource AncestorType=controls:PropertyPanel}}" />

            <StackPanel Margin="0,0,0,8" Visibility="{Binding HasPlaceholder, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{l:Loc Emoji_Placeholder}" TextWrapping="Wrap" Foreground="#F5A623" />
              <TextBlock Text="{Binding PlaceholderName}" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0" />
            </StackPanel>

            <controls:PanelSection Header="{l:Loc Section_Geometry}" SectionKey="Geometry"
                                   Visibility="{Binding HasEmojis, Converter={StaticResource BoolToVisibility}}">
              <controls:PanelSection.Summary>
                <TextBlock Style="{StaticResource SummaryText}">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0:0} × {1:0}">
                      <Binding Path="Width" />
                      <Binding Path="Height" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </controls:PanelSection.Summary>
              <StackPanel>
                <TextBlock Text="{l:Loc Emoji_Size}" Style="{StaticResource FieldLabel}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <controls:SpinBox Minimum="8" Maximum="10000" SmallChange="1" LargeChange="10" Unit="px"
                                    Value="{Binding Width}" AutomationProperties.Name="{l:Loc Emoji_Width}" ToolTip="{l:Loc Emoji_Width}" />
                  <TextBlock Grid.Column="1" Text="×" Margin="6,0" VerticalAlignment="Center" />
                  <controls:SpinBox Grid.Column="2" Minimum="8" Maximum="10000" SmallChange="1" LargeChange="10" Unit="px"
                                    Value="{Binding Height}" AutomationProperties.Name="{l:Loc Emoji_Height}" ToolTip="{l:Loc Emoji_Height}" />
                </Grid>
                <ui:Button Content="{l:Loc Emoji_ResetAspect}" Margin="0,6,0,0" HorizontalAlignment="Stretch" Command="{Binding ResetAspectCommand}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{l:Loc Section_Rotation}" Style="{StaticResource FieldLabel}" />
                    <DockPanel>
                      <ui:Button DockPanel.Dock="Right" Style="{StaticResource ResetButton}" Icon="{ui:SymbolIcon ArrowReset24}" AutomationProperties.Name="{l:Loc Emoji_ResetRotation}" Command="{Binding ResetRotationCommand}" />
                      <controls:SpinBox Minimum="0" Maximum="359.9" SmallChange="1" LargeChange="15" Decimals="1" Unit="°"
                                        Value="{Binding Rotation}" AutomationProperties.Name="{l:Loc Emoji_Rotation}" />
                    </DockPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:Loc Emoji_Flip}" Style="{StaticResource FieldLabel}" />
                    <StackPanel Orientation="Horizontal">
                      <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding FlipHorizontal, Mode=TwoWay}" ToolTip="{l:Loc Emoji_FlipH}" AutomationProperties.Name="{l:Loc Emoji_FlipH}">
                        <ui:SymbolIcon Symbol="FlipHorizontal24" />
                      </ToggleButton>
                      <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding FlipVertical, Mode=TwoWay}" ToolTip="{l:Loc Emoji_FlipV}" AutomationProperties.Name="{l:Loc Emoji_FlipV}">
                        <ui:SymbolIcon Symbol="FlipVertical24" />
                      </ToggleButton>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </controls:PanelSection>

            <StackPanel Visibility="{Binding ShowDefaults, Converter={StaticResource BoolToVisibility}}">

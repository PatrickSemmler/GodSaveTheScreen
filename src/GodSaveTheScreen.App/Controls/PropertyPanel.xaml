                  </ToggleButton>
                  <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsUnderline, Mode=TwoWay}" ToolTip="{l:Loc Text_Underline}" AutomationProperties.Name="{l:Loc Text_Underline}">
                    <ui:SymbolIcon Symbol="TextUnderline24" />
                  </ToggleButton>
                  <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsStrikethrough, Mode=TwoWay}" ToolTip="{l:Loc Text_Strikethrough}" AutomationProperties.Name="{l:Loc Text_Strikethrough}">
                    <ui:SymbolIcon Symbol="TextStrikethrough24" />
                  </ToggleButton>
                  <Rectangle Width="1" Height="22" Margin="3,0,5,2" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />
                  <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsAlignLeft, Mode=TwoWay}" ToolTip="{l:Loc Text_AlignLeft}" AutomationProperties.Name="{l:Loc Text_AlignLeft}">
                    <ui:SymbolIcon Symbol="TextAlignLeft24" />
                  </ToggleButton>
                  <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsAlignCenter, Mode=TwoWay}" ToolTip="{l:Loc Text_AlignCenter}" AutomationProperties.Name="{l:Loc Text_AlignCenter}">
                    <ui:SymbolIcon Symbol="TextAlignCenter24" />
                  </ToggleButton>
                  <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsAlignRight, Mode=TwoWay}" ToolTip="{l:Loc Text_AlignRight}" AutomationProperties.Name="{l:Loc Text_AlignRight}">

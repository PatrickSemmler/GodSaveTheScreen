              <WrapPanel Margin="0,10,0,0">
                <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding FlipHorizontal, Mode=TwoWay}" ToolTip="{l:Loc Emoji_FlipH}" AutomationProperties.Name="{l:Loc Emoji_FlipH}">
                  <ui:SymbolIcon Symbol="FlipHorizontal24" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding FlipVertical, Mode=TwoWay}" ToolTip="{l:Loc Emoji_FlipV}" AutomationProperties.Name="{l:Loc Emoji_FlipV}">
                  <ui:SymbolIcon Symbol="FlipVertical24" />
                </ToggleButton>
              </WrapPanel>
            </StackPanel>

            <TextBlock Text="{l:Loc Image_Outline}" Style="{StaticResource FieldLabel}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <controls:ColorButton Style="{StaticResource PanelColorButton}" SelectedColor="{Binding OutlineColor, Mode=TwoWay}" />
              <ui:NumberBox Grid.Column="1" Width="72" Margin="8,0,0,0" SpinButtonPlacementMode="Hidden"
                            Minimum="0" Maximum="50" SmallChange="0.5" LargeChange="2" MaxDecimalPlaces="1" ClearButtonEnabled="False"
                            Value="{Binding OutlineThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="{l:Loc Image_OutlineWidth}" ToolTip="{l:Loc Image_OutlineWidth}" />
            </Grid>

            <TextBlock Text="{l:Loc Image_OutlineBlur}" Style="{StaticResource FieldLabel}" />
            <ui:NumberBox Minimum="0" Maximum="50" SmallChange="1" LargeChange="5" MaxDecimalPlaces="1" ClearButtonEnabled="False"
                          Value="{Binding OutlineBlur, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.Name="{l:Loc Image_OutlineBlur}" />

            <StackPanel Visibility="{Binding ShowDefaults, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{l:Loc Props_Opacity}" Style="{StaticResource FieldLabel}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                        Value="{Binding DefaultOpacityValue, Mode=TwoWay}"
                        AutomationProperties.Name="{l:Loc Props_Opacity}" />
                <ui:NumberBox Grid.Column="1" Width="72" Margin="8,0,0,0" SpinButtonPlacementMode="Hidden"
                              Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" MaxDecimalPlaces="0" ClearButtonEnabled="False"
                              Value="{Binding DefaultOpacityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.Name="{l:Loc Props_Opacity}" />
              </Grid>
            </StackPanel>
          </StackPanel>

          <!-- Drehung ausgewählter Formen, Polygone, Freihandstriche und Texte (keine Werkzeug-Vorgabe) -->
          <StackPanel DataContext="{Binding RotationProperties}" Visibility="{Binding IsApplicable, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{l:Loc Props_Rotation}" Style="{StaticResource FieldLabel}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Slider Minimum="-180" Maximum="180" SmallChange="1" LargeChange="15" VerticalAlignment="Center"
                      Value="{Binding RotationValue, Mode=TwoWay}"
                      AutomationProperties.Name="{l:Loc Props_Rotation}" />
              <ui:NumberBox Grid.Column="1" Width="72" Margin="8,0,0,0" SpinButtonPlacementMode="Hidden"
                            Minimum="-180" Maximum="180" SmallChange="1" LargeChange="15" MaxDecimalPlaces="1" ClearButtonEnabled="False"
                            Value="{Binding Rotation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="{l:Loc Props_Rotation}" />
              <ui:Button Grid.Column="2" Content="{l:Loc Emoji_ResetRotation}" Margin="8,0,0,0" Command="{Binding ResetRotationCommand}" />
            </Grid>
          </StackPanel>

          <!-- Schatten (Formen, Linien, Text, Marker, Emoji, Sprechblasen, Bilder) -->
          <StackPanel DataContext="{Binding ShadowProperties}" Visibility="{Binding IsApplicable, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{l:Loc Shadow_Color}" Style="{StaticResource FieldLabel}" />
            <controls:ColorButton Style="{StaticResource PanelColorButton}" SelectedColor="{Binding ShadowColor, Mode=TwoWay}" />

            <TextBlock Text="{l:Loc Shadow_Size}" Style="{StaticResource FieldLabel}" />
            <ui:NumberBox Minimum="0" Maximum="200" SmallChange="1" LargeChange="5" MaxDecimalPlaces="1" ClearButtonEnabled="False"
                          Value="{Binding ShadowSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.Name="{l:Loc Shadow_Size}" />

            <TextBlock Text="{l:Loc Shadow_Blur}" Style="{StaticResource FieldLabel}" />
            <ui:NumberBox Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" MaxDecimalPlaces="1" ClearButtonEnabled="False"
                          Value="{Binding ShadowBlur, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.Name="{l:Loc Shadow_Blur}" />
          </StackPanel>

          <!-- Deckkraft für alle Objekte -->
          <StackPanel DataContext="{Binding Properties}" Visibility="{Binding ShowOpacity, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{l:Loc Props_Opacity}" Style="{StaticResource FieldLabel}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                      Value="{Binding OpacityValue, Mode=TwoWay}"
                      AutomationProperties.Name="{l:Loc Props_Opacity}" />
              <ui:NumberBox Grid.Column="1" Width="72" Margin="8,0,0,0" SpinButtonPlacementMode="Hidden"
                            Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" MaxDecimalPlaces="0"
                            ClearButtonEnabled="False"
                            Value="{Binding OpacityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="{l:Loc Props_Opacity}" />
            </Grid>
          </StackPanel>

          <!-- Werkzeug-Einstellungen auf die Standardwerte zurücksetzen -->
          <ui:Button Content="{l:Loc Props_ResetDefaults}" Icon="{ui:SymbolIcon ArrowReset24}" Margin="0,16,0,0" HorizontalAlignment="Stretch"
                     Command="{Binding ResetToolDefaultsCommand}" ToolTip="{l:Loc Props_ResetDefaultsTip}"
                     Visibility="{Binding CanResetToolDefaults, Converter={StaticResource BoolToVisibility}}" />

          <!-- Vorlagen des aktiven Werkzeugs -->
          <controls:PresetList DataContext="{Binding Presets}" Visibility="{Binding IsApplicable, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="{l:Loc Panel_Layers}">
      <controls:LayersPanel DataContext="{Binding Layers}" />
    </TabItem>
  </TabControl>
</UserControl>

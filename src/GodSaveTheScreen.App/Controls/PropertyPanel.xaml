                       Visibility="{Binding ShowDefaults, Converter={StaticResource BoolToVisibility}}" />

            <controls:PanelSection Header="{l:Loc Stamp_QuickText}" SectionKey="StampQuickText">
              <ItemsControl ItemsSource="{Binding QuickTexts}" Focusable="False" Margin="0,4,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Content="{Binding}" Margin="0,0,3,3" Padding="4,4" HorizontalAlignment="Stretch" FontSize="11"
                            Command="{Binding DataContext.ApplyTextCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </controls:PanelSection>

            <controls:PanelSection Header="{l:Loc Section_Style}" SectionKey="Style">
              <controls:PanelSection.Summary>
                <Border Style="{StaticResource SummarySwatch}" Background="{Binding Color, Converter={StaticResource ColorBrush}}" />
              </controls:PanelSection.Summary>
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="76" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{l:Loc Stamp_Color}" Style="{StaticResource FieldLabel}" />
                    <controls:ColorButton Style="{StaticResource CompactColor}" SelectedColor="{Binding Color, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:Loc Stamp_Frame}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding FrameChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding FrameShape, Mode=TwoWay}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="{l:Loc Stamp_Frame}" />
                  </StackPanel>
                  <StackPanel Grid.Column="4">
                    <TextBlock Text="{l:Loc Field_Width}" Style="{StaticResource FieldLabel}" ToolTip="{l:Loc Stamp_FrameThickness}" />
                    <controls:SpinBox Minimum="0" Maximum="200" SmallChange="0.5" LargeChange="2" Decimals="1"
                                      Value="{Binding FrameThickness}" AutomationProperties.Name="{l:Loc Stamp_FrameThickness}" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="{l:Loc Stamp_Wear}" Style="{StaticResource FieldLabel}" />
                <DockPanel>
                  <controls:SpinBox DockPanel.Dock="Right" Style="{StaticResource SliderSpin}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" Unit="%"
                                    Value="{Binding Wear}" AutomationProperties.Name="{l:Loc Stamp_Wear}" />
                  <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                          Value="{Binding WearValue, Mode=TwoWay}"
                          AutomationProperties.Name="{l:Loc Stamp_Wear}" />
                </DockPanel>
                <ui:Button Content="{l:Loc Stamp_Reroll}" Margin="0,6,0,0" HorizontalAlignment="Stretch" Command="{Binding RerollCommand}"
                           Visibility="{Binding HasStamps, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{l:Loc Stamp_Rotation}" Style="{StaticResource FieldLabel}" />
                <DockPanel>
                  <controls:SpinBox DockPanel.Dock="Right" Style="{StaticResource SliderSpin}" Minimum="-180" Maximum="180" SmallChange="1" LargeChange="5" Decimals="1" Unit="°"
                                    Value="{Binding Rotation}" AutomationProperties.Name="{l:Loc Stamp_Rotation}" />
                  <Slider Minimum="-45" Maximum="45" SmallChange="1" LargeChange="5" VerticalAlignment="Center"
                          Value="{Binding RotationValue, Mode=TwoWay}"
                          AutomationProperties.Name="{l:Loc Stamp_Rotation}" />
                </DockPanel>
                <CheckBox Content="{l:Loc Stamp_InkBlend}" Margin="0,10,0,0" IsChecked="{Binding InkBlend, Mode=TwoWay}" />
              </StackPanel>
            </controls:PanelSection>

            <controls:PanelSection Header="{l:Loc Section_Font}" SectionKey="Font">
              <controls:PanelSection.Summary>
                <TextBlock Style="{StaticResource SummaryText}" MaxWidth="120">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} · {1:0.#}">
                      <Binding Path="FontFamilyName" />
                      <Binding Path="FontSize" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </controls:PanelSection.Summary>
              <StackPanel>
                <TextBlock Text="{l:Loc Text_Font}" Style="{StaticResource FieldLabel}" />
                <ComboBox Style="{StaticResource FontComboBox}" ItemsSource="{Binding Fonts}" SelectedValue="{Binding FontFamilyName, Mode=TwoWay}"
                          AutomationProperties.Name="{l:Loc Text_Font}" />
                <TextBlock Text="{l:Loc Text_FontMissing}" Foreground="#F5A623" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding IsFontMissing, Converter={StaticResource BoolToVisibility}}" />

                  <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsItalic, Mode=TwoWay}" ToolTip="{l:Loc Text_Italic}" AutomationProperties.Name="{l:Loc Text_Italic}">
                    <ui:SymbolIcon Symbol="TextItalic24" />
                  </ToggleButton>
                  <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsUnderline, Mode=TwoWay}" ToolTip="{l:Loc Text_Underline}" AutomationProperties.Name="{l:Loc Text_Underline}">
                    <ui:SymbolIcon Symbol="TextUnderline24" />
                  </ToggleButton>
                  <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsStrikethrough, Mode=TwoWay}" ToolTip="{l:Loc Text_Strikethrough}" AutomationProperties.Name="{l:Loc Text_Strikethrough}">
                    <ui:SymbolIcon Symbol="TextStrikethrough24" />
                  </ToggleButton>
                </WrapPanel>
              </StackPanel>
            </controls:PanelSection>

            <StackPanel Visibility="{Binding ShowDefaults, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{l:Loc Props_Opacity}" Style="{StaticResource FieldLabel}" Margin="0,4,0,3" />
              <DockPanel>
                <controls:SpinBox DockPanel.Dock="Right" Style="{StaticResource SliderSpin}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" Unit="%"
                                  Value="{Binding DefaultOpacityPercent}" AutomationProperties.Name="{l:Loc Props_Opacity}" />
                <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                        Value="{Binding DefaultOpacityValue, Mode=TwoWay}"
                        AutomationProperties.Name="{l:Loc Props_Opacity}" />
              </DockPanel>
            </StackPanel>
          </StackPanel>

          <!-- Sprechblase -->
          <StackPanel DataContext="{Binding CalloutProperties}" Visibility="{Binding IsApplicable, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{l:Loc Callout_Hint}" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8"
                       Visibility="{Binding ShowDefaults, Converter={StaticResource BoolToVisibility}}" />

            <controls:PanelSection Header="{l:Loc Section_CalloutShape}" SectionKey="CalloutShape">
              <StackPanel>
                <TextBlock Text="{l:Loc Callout_Shape}" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding ShapeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Shape, Mode=TwoWay}" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="{l:Loc Callout_Shape}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Visibility="{Binding ShowCornerRadius, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{l:Loc Props_CornerRadius}" Style="{StaticResource FieldLabel}" />
                    <controls:SpinBox Minimum="0" Maximum="500" SmallChange="1" LargeChange="10" Unit="px"
                                      Value="{Binding CornerRadius}" AutomationProperties.Name="{l:Loc Props_CornerRadius}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:Loc Callout_TailWidth}" Style="{StaticResource FieldLabel}" />
                    <controls:SpinBox Minimum="1" Maximum="500" SmallChange="1" LargeChange="5" Unit="px"
                                      Value="{Binding TailWidth}" AutomationProperties.Name="{l:Loc Callout_TailWidth}" />
                  </StackPanel>
                </Grid>
                <StackPanel Visibility="{Binding ShowTailCurved, Converter={StaticResource BoolToVisibility}}">
                  <CheckBox Content="{l:Loc Callout_TailCurved}" Margin="0,10,0,0" IsChecked="{Binding TailCurved, Mode=TwoWay}" />
                  <CheckBox Content="{l:Loc Callout_TailCurveReversed}" Margin="24,6,0,0" IsChecked="{Binding TailCurveReversed, Mode=TwoWay}"
                            IsEnabled="{Binding TailCurved}" />
                </StackPanel>
                <!-- Drehung nur für ausgewählte Blasen (keine Werkzeug-Vorgabe) -->
                <StackPanel Visibility="{Binding ShowRotation, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="{l:Loc Callout_Rotation}" Style="{StaticResource FieldLabel}" />
                  <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource ResetButton}" Icon="{ui:SymbolIcon ArrowReset24}" AutomationProperties.Name="{l:Loc Emoji_ResetRotation}" Command="{Binding ResetRotationCommand}" />
                    <controls:SpinBox DockPanel.Dock="Right" Style="{StaticResource SliderSpin}" Minimum="-180" Maximum="180" SmallChange="1" LargeChange="15" Decimals="1" Unit="°"
                                      Value="{Binding Rotation}" AutomationProperties.Name="{l:Loc Callout_Rotation}" />
                    <Slider Minimum="-180" Maximum="180" SmallChange="1" LargeChange="15" VerticalAlignment="Center"
                            Value="{Binding RotationValue, Mode=TwoWay}"
                            AutomationProperties.Name="{l:Loc Callout_Rotation}" />
                  </DockPanel>
                </StackPanel>
              </StackPanel>
            </controls:PanelSection>

            <controls:PanelSection Header="{l:Loc Section_Font}" SectionKey="Font">
              <controls:PanelSection.Summary>
                <TextBlock Style="{StaticResource SummaryText}" MaxWidth="120">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} · {1:0.#}">
                      <Binding Path="FontFamilyName" />
                      <Binding Path="FontSize" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </controls:PanelSection.Summary>
              <StackPanel>
                <TextBlock Text="{l:Loc Text_Font}" Style="{StaticResource FieldLabel}" />
                <ComboBox Style="{StaticResource FontComboBox}" ItemsSource="{Binding Fonts}" SelectedValue="{Binding FontFamilyName, Mode=TwoWay}"
                          AutomationProperties.Name="{l:Loc Text_Font}" />
                <TextBlock Text="{l:Loc Text_FontMissing}" Foreground="#F5A623" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding IsFontMissing, Converter={StaticResource BoolToVisibility}}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="84" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{l:Loc Text_Typeface}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Typefaces}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedTypeface, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" AutomationProperties.Name="{l:Loc Text_Typeface}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:Loc Text_Size}" Style="{StaticResource FieldLabel}" />
                    <controls:SpinBox Minimum="1" Maximum="999" SmallChange="1" LargeChange="10" Decimals="1" Unit="pt"
                                      Value="{Binding FontSize}" AutomationProperties.Name="{l:Loc Text_Size}" />
                  </StackPanel>
                </Grid>
                <WrapPanel Margin="0,8,0,0">
                  <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsBold, Mode=TwoWay}" ToolTip="{l:Loc Text_Bold}" AutomationProperties.Name="{l:Loc Text_Bold}">

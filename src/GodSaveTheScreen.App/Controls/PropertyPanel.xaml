                    <TextBlock Text="{l:Loc Mask_Tolerance}" Style="{StaticResource FieldLabel}" />
                    <DockPanel>
                      <controls:SpinBox DockPanel.Dock="Right" Style="{StaticResource SliderSpin}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" Unit="%"
                                        Value="{Binding Tolerance}" AutomationProperties.Name="{l:Loc Mask_Tolerance}" />
                      <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" VerticalAlignment="Center"
                              Value="{Binding Tolerance, Mode=TwoWay}"
                              AutomationProperties.Name="{l:Loc Mask_Tolerance}" />
                    </DockPanel>
                  </StackPanel>
                  <TextBlock Text="{l:Loc Mask_Feather}" Style="{StaticResource FieldLabel}" />
                  <DockPanel>
                    <controls:SpinBox DockPanel.Dock="Right" Style="{StaticResource SliderSpin}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" Unit="px"
                                      Value="{Binding Feather}" AutomationProperties.Name="{l:Loc Mask_Feather}" />

<UserControl x:Class="GodSaveTheScreen.App.Controls.PropertyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:GodSaveTheScreen.App.Localization"
             xmlns:controls="clr-namespace:GodSaveTheScreen.App.Controls"
             xmlns:core="clr-namespace:GodSaveTheScreen.Core.Annotations;assembly=GodSaveTheScreen.Core">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,10,0,4" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Margin" Value="0,0,3,3" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="PanelColorButton" TargetType="controls:ColorButton">
      <Setter Property="RecentColors" Value="{Binding DataContext.Properties.RecentColors, RelativeSource={RelativeSource AncestorType=controls:PropertyPanel}}" />
      <Setter Property="PipetteCommand" Value="{Binding DataContext.Properties.PipetteCommand, RelativeSource={RelativeSource AncestorType=controls:PropertyPanel}}" />
      <Setter Property="RememberCommand" Value="{Binding DataContext.Properties.RememberColorCommand, RelativeSource={RelativeSource AncestorType=controls:PropertyPanel}}" />
    </Style>
  </UserControl.Resources>
  <TabControl Padding="0" Margin="0">
    <TabItem Header="{l:Loc Panel_Properties}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel Margin="12,4,4,12">
          <TextBlock Text="{l:Loc Props_NothingSelected}" TextWrapping="Wrap" Opacity="0.6" Margin="0,12,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasPanelContent}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <TextBlock Text="{Binding PanelHeader}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"
                     Visibility="{Binding HasPanelContent, Converter={StaticResource BoolToVisibility}}" />

          <!-- Text -->
          <StackPanel DataContext="{Binding TextProperties}" Visibility="{Binding IsApplicable, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{l:Loc Text_Font}" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="FontBox"
                      ItemsSource="{Binding Fonts}"
                      SelectedValuePath="Key"
                      SelectedValue="{Binding FontFamilyName, Mode=TwoWay}"
                      IsTextSearchEnabled="True"
                      TextSearch.TextPath="DisplayName"
                      MaxDropDownHeight="360"
                      HorizontalAlignment="Stretch"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      AutomationProperties.Name="{l:Loc Text_Font}">
              <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ComboBox.ItemsPanel>
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisplayName}" FontFamily="{Binding Family}" FontSize="15" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{l:Loc Text_FontMissing}" Foreground="#F5A623" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding IsFontMissing, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="{l:Loc Text_Typeface}" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding Typefaces}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedTypeface, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      AutomationProperties.Name="{l:Loc Text_Typeface}" />

            <TextBlock Text="{l:Loc Text_Size}" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="SizeBox"
                      IsEditable="True"
                      ItemsSource="{Binding FontSizes}"
                      Text="{Binding FontSizeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                      DropDownClosed="OnFontSizeDropDownClosed"
                      HorizontalAlignment="Stretch"
                      AutomationProperties.Name="{l:Loc Text_Size}" />

            <WrapPanel Margin="0,10,0,0">
              <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsBold, Mode=TwoWay}" ToolTip="{l:Loc Text_Bold}" AutomationProperties.Name="{l:Loc Text_Bold}">
                <ui:SymbolIcon Symbol="TextBold24" />
              </ToggleButton>
              <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsItalic, Mode=TwoWay}" ToolTip="{l:Loc Text_Italic}" AutomationProperties.Name="{l:Loc Text_Italic}">
                <ui:SymbolIcon Symbol="TextItalic24" />
              </ToggleButton>
              <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsUnderline, Mode=TwoWay}" ToolTip="{l:Loc Text_Underline}" AutomationProperties.Name="{l:Loc Text_Underline}">
                <ui:SymbolIcon Symbol="TextUnderline24" />
              </ToggleButton>
              <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsStrikethrough, Mode=TwoWay}" ToolTip="{l:Loc Text_Strikethrough}" AutomationProperties.Name="{l:Loc Text_Strikethrough}">
                <ui:SymbolIcon Symbol="TextStrikethrough24" />
              </ToggleButton>
              <Rectangle Width="1" Height="24" Margin="4,0,7,3" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />
              <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsAlignLeft, Mode=TwoWay}" ToolTip="{l:Loc Text_AlignLeft}" AutomationProperties.Name="{l:Loc Text_AlignLeft}">
                <ui:SymbolIcon Symbol="TextAlignLeft24" />
              </ToggleButton>
              <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsAlignCenter, Mode=TwoWay}" ToolTip="{l:Loc Text_AlignCenter}" AutomationProperties.Name="{l:Loc Text_AlignCenter}">
                <ui:SymbolIcon Symbol="TextAlignCenter24" />
              </ToggleButton>
              <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsAlignRight, Mode=TwoWay}" ToolTip="{l:Loc Text_AlignRight}" AutomationProperties.Name="{l:Loc Text_AlignRight}">
                <ui:SymbolIcon Symbol="TextAlignRight24" />
              </ToggleButton>
            </WrapPanel>

            <TextBlock Text="{l:Loc Text_Color}" Style="{StaticResource FieldLabel}" />
            <controls:ColorButton Style="{StaticResource PanelColorButton}" SelectedColor="{Binding TextColor, Mode=TwoWay}" />

            <TextBlock Text="{l:Loc Text_Outline}" Style="{StaticResource FieldLabel}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <controls:ColorButton Style="{StaticResource PanelColorButton}" SelectedColor="{Binding OutlineColor, Mode=TwoWay}" />
              <ui:NumberBox Grid.Column="1" Width="72" Margin="8,0,0,0" SpinButtonPlacementMode="Hidden"
                            Minimum="0" Maximum="50" SmallChange="0.5" LargeChange="2" MaxDecimalPlaces="1" ClearButtonEnabled="False"
                            Value="{Binding OutlineThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="{l:Loc Text_OutlineWidth}" />
            </Grid>

            <TextBlock Text="{l:Loc Text_Background}" Style="{StaticResource FieldLabel}" />
            <controls:ColorButton Style="{StaticResource PanelColorButton}" SelectedColor="{Binding BackgroundColor, Mode=TwoWay}" />

            <TextBlock Text="{l:Loc Text_Presets}" Style="{StaticResource FieldLabel}" />
            <ItemsControl ItemsSource="{Binding Presets}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ui:Button Content="{Binding Name}" Margin="0,0,6,6"
                             Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                             CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Marker -->
          <StackPanel DataContext="{Binding MarkerProperties}" Visibility="{Binding IsApplicable, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Visibility="{Binding ShowNumber, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{l:Loc Marker_Number}" Style="{StaticResource FieldLabel}" />
              <ui:NumberBox Minimum="0" Maximum="9999" SmallChange="1" LargeChange="5" MaxDecimalPlaces="0" ClearButtonEnabled="False"
                            Value="{Binding Number, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="{l:Loc Marker_Number}" />
            </StackPanel>

            <TextBlock Text="{l:Loc Marker_Shape}" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding ShapeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding Shape, Mode=TwoWay}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="{l:Loc Marker_Shape}" />

            <TextBlock Text="{l:Loc Marker_Size}" Style="{StaticResource FieldLabel}" />
            <ui:NumberBox Minimum="8" Maximum="400" SmallChange="2" LargeChange="10" MaxDecimalPlaces="0" ClearButtonEnabled="False"
                          Value="{Binding Size, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.Name="{l:Loc Marker_Size}" />

            <TextBlock Text="{l:Loc Marker_Fill}" Style="{StaticResource FieldLabel}" />
            <controls:ColorButton Style="{StaticResource PanelColorButton}" SelectedColor="{Binding FillColor, Mode=TwoWay}" />

            <TextBlock Text="{l:Loc Marker_TextColor}" Style="{StaticResource FieldLabel}" />
            <controls:ColorButton Style="{StaticResource PanelColorButton}" SelectedColor="{Binding TextColor, Mode=TwoWay}" />

            <TextBlock Text="{l:Loc Marker_Outline}" Style="{StaticResource FieldLabel}" />
            <controls:ColorButton Style="{StaticResource PanelColorButton}" SelectedColor="{Binding OutlineColor, Mode=TwoWay}" />

            <TextBlock Text="{l:Loc Marker_StartNumber}" Style="{StaticResource FieldLabel}" />
            <ui:NumberBox Minimum="0" Maximum="9999" SmallChange="1" LargeChange="5" MaxDecimalPlaces="0" ClearButtonEnabled="False"
                          Value="{Binding StartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.Name="{l:Loc Marker_StartNumber}" />

            <ui:Button Content="{l:Loc Marker_RenumberZ}" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                       Command="{Binding RenumberCommand}" CommandParameter="{x:Static core:MarkerOrder.ZOrder}" />
            <ui:Button Content="{l:Loc Marker_RenumberCreation}" Margin="0,6,0,0" HorizontalAlignment="Stretch"
                       Command="{Binding RenumberCommand}" CommandParameter="{x:Static core:MarkerOrder.Creation}" />
          </StackPanel>

          <!-- Freihand, Radierer, Unschärfe, Lupe -->
          <StackPanel DataContext="{Binding ToolOptions}" Visibility="{Binding IsApplicable, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Visibility="{Binding ShowStroke, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{l:Loc Opt_Smoothing}" Style="{StaticResource FieldLabel}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                        Value="{Binding SmoothingPercent, Mode=TwoWay, TargetNullValue=0}"
                        AutomationProperties.Name="{l:Loc Opt_Smoothing}" />
                <TextBlock Grid.Column="1" Width="40" Margin="8,0,0,0" TextAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding SmoothingPercent, StringFormat={}{0:0} %}" />
              </Grid>
              <CheckBox Content="{l:Loc Opt_Pressure}" Margin="0,10,0,0" IsChecked="{Binding UsePressure, Mode=TwoWay}" />
              <CheckBox Content="{l:Loc Opt_HighlighterBehind}" Margin="0,6,0,0" IsChecked="{Binding HighlightersBehind, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Visibility="{Binding ShowEraser, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{l:Loc Opt_EraserHint}" TextWrapping="Wrap" Opacity="0.75" Margin="0,10,0,0" />
              <CheckBox Content="{l:Loc Opt_EraserAll}" Margin="0,10,0,0" IsChecked="{Binding EraserAllObjects, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Visibility="{Binding ShowBlur, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{l:Loc Blur_Mode}" Style="{StaticResource FieldLabel}" />
              <ComboBox ItemsSource="{Binding ModeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                        SelectedValue="{Binding Mode, Mode=TwoWay}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{l:Loc Blur_Mode}" />
              <StackPanel Visibility="{Binding ShowStrength, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{l:Loc Blur_Strength}" Style="{StaticResource FieldLabel}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Slider Minimum="2" Maximum="100" SmallChange="1" LargeChange="5" VerticalAlignment="Center"
                          Value="{Binding Strength, Mode=TwoWay, TargetNullValue=2}"
                          AutomationProperties.Name="{l:Loc Blur_Strength}" />
                  <ui:NumberBox Grid.Column="1" Width="72" Margin="8,0,0,0" SpinButtonPlacementMode="Hidden"
                                Minimum="2" Maximum="100" SmallChange="1" LargeChange="5" MaxDecimalPlaces="0" ClearButtonEnabled="False"
                                Value="{Binding Strength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.Name="{l:Loc Blur_Strength}" />
                </Grid>
              </StackPanel>
              <StackPanel Visibility="{Binding ShowRedactColor, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{l:Loc Blur_RedactColor}" Style="{StaticResource FieldLabel}" />
                <controls:ColorButton Style="{StaticResource PanelColorButton}" SelectedColor="{Binding RedactColor, Mode=TwoWay}" />
              </StackPanel>
              <TextBlock Text="{l:Loc Blur_Shape}" Style="{StaticResource FieldLabel}" />
              <ComboBox ItemsSource="{Binding RegionShapeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                        SelectedValue="{Binding RegionShapeValue, Mode=TwoWay}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{l:Loc Blur_Shape}" />
              <TextBlock Text="{l:Loc Blur_Feather}" Style="{StaticResource FieldLabel}" />
              <ui:NumberBox Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" MaxDecimalPlaces="0" ClearButtonEnabled="False"
                            Value="{Binding FeatherEdge, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="{l:Loc Blur_Feather}" />
              <TextBlock Text="{l:Loc Blur_Warning}" TextWrapping="Wrap" Foreground="#F5A623" Margin="0,10,0,0"
                         Visibility="{Binding ShowBlurWarning, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <StackPanel Visibility="{Binding ShowMagnifier, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{l:Loc Mag_Zoom}" Style="{StaticResource FieldLabel}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider Minimum="1.5" Maximum="8" SmallChange="0.5" LargeChange="1" VerticalAlignment="Center"
                        Value="{Binding Zoom, Mode=TwoWay, TargetNullValue=2}"
                        AutomationProperties.Name="{l:Loc Mag_Zoom}" />
                <ui:NumberBox Grid.Column="1" Width="72" Margin="8,0,0,0" SpinButtonPlacementMode="Hidden"
                              Minimum="1.5" Maximum="8" SmallChange="0.5" LargeChange="1" MaxDecimalPlaces="1" ClearButtonEnabled="False"
                              Value="{Binding Zoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.Name="{l:Loc Mag_Zoom}" />
              </Grid>
              <TextBlock Text="{l:Loc Mag_Shape}" Style="{StaticResource FieldLabel}" />
              <ComboBox ItemsSource="{Binding MagnifierShapeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                        SelectedValue="{Binding MagnifierShapeValue, Mode=TwoWay}" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{l:Loc Mag_Shape}" />
              <TextBlock Text="{l:Loc Mag_Border}" Style="{StaticResource FieldLabel}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:ColorButton Style="{StaticResource PanelColorButton}" SelectedColor="{Binding BorderColor, Mode=TwoWay}" />
                <ui:NumberBox Grid.Column="1" Width="72" Margin="8,0,0,0" SpinButtonPlacementMode="Hidden"
                              Minimum="0" Maximum="50" SmallChange="0.5" LargeChange="2" MaxDecimalPlaces="1" ClearButtonEnabled="False"
                              Value="{Binding BorderThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.Name="{l:Loc Mag_Border}" />
              </Grid>
              <CheckBox Content="{l:Loc Mag_Connector}" Margin="0,10,0,0" IsChecked="{Binding ShowConnector, Mode=TwoWay}" />
              <CheckBox Content="{l:Loc Mag_SourceFrame}" Margin="0,6,0,0" IsChecked="{Binding ShowSourceFrame, Mode=TwoWay}" />
              <CheckBox Content="{l:Loc Mag_BaseOnly}" Margin="0,6,0,0" IsChecked="{Binding BaseImageOnly, Mode=TwoWay}" />
              <CheckBox Content="{l:Loc Mag_Smooth}" Margin="0,6,0,0" IsChecked="{Binding SmoothScaling, Mode=TwoWay}" />
            </StackPanel>
          </StackPanel>

          <!-- Formen -->
          <StackPanel DataContext="{Binding Properties}" Visibility="{Binding IsApplicable, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{l:Loc Props_StrokeColor}" Style="{StaticResource FieldLabel}" />
            <controls:ColorButton SelectedColor="{Binding StrokeColor, Mode=TwoWay}"
                                  RecentColors="{Binding RecentColors}"
                                  PipetteCommand="{Binding PipetteCommand}"
                                  RememberCommand="{Binding RememberColorCommand}" />

            <StackPanel Visibility="{Binding ShowFill, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{l:Loc Props_FillColor}" Style="{StaticResource FieldLabel}" />
              <controls:ColorButton SelectedColor="{Binding FillColor, Mode=TwoWay}"
                                    RecentColors="{Binding RecentColors}"
                                    PipetteCommand="{Binding PipetteCommand}"
                                    RememberCommand="{Binding RememberColorCommand}" />
            </StackPanel>

            <TextBlock Text="{l:Loc Props_Thickness}" Style="{StaticResource FieldLabel}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Slider Minimum="0" Maximum="40" SmallChange="0.5" LargeChange="2" VerticalAlignment="Center"
                      Value="{Binding ThicknessValue, Mode=TwoWay}"
                      AutomationProperties.Name="{l:Loc Props_Thickness}" />
              <ui:NumberBox Grid.Column="1" Width="72" Margin="8,0,0,0" SpinButtonPlacementMode="Hidden"
                            Minimum="0" Maximum="100" SmallChange="0.5" LargeChange="5" MaxDecimalPlaces="1"
                            ClearButtonEnabled="False"
                            Value="{Binding Thickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="{l:Loc Props_Thickness}" />
            </Grid>

            <StackPanel Visibility="{Binding ShowDash, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{l:Loc Props_Dash}" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding DashChoices}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding Dash, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      AutomationProperties.Name="{l:Loc Props_Dash}" />
            </StackPanel>

            <StackPanel Visibility="{Binding ShowCornerRadius, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{l:Loc Props_CornerRadius}" Style="{StaticResource FieldLabel}" />
              <ui:NumberBox Minimum="0" Maximum="500" SmallChange="1" LargeChange="10" MaxDecimalPlaces="0"
                            ClearButtonEnabled="False"
                            Value="{Binding CornerRadius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="{l:Loc Props_CornerRadius}" />
            </StackPanel>

            <StackPanel Visibility="{Binding ShowCaps, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{l:Loc Props_StartCap}" Style="{StaticResource FieldLabel}" />
              <ComboBox ItemsSource="{Binding CapChoices}"
                        DisplayMemberPath="Label"
                        SelectedValuePath="Value"
                        SelectedValue="{Binding StartCap, Mode=TwoWay}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{l:Loc Props_StartCap}" />
              <TextBlock Text="{l:Loc Props_EndCap}" Style="{StaticResource FieldLabel}" />
              <ComboBox ItemsSource="{Binding CapChoices}"
                        DisplayMemberPath="Label"
                        SelectedValuePath="Value"
                        SelectedValue="{Binding EndCap, Mode=TwoWay}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{l:Loc Props_EndCap}" />
            </StackPanel>
          </StackPanel>

          <!-- Deckkraft für alle Objekte -->
          <StackPanel DataContext="{Binding Properties}" Visibility="{Binding ShowOpacity, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{l:Loc Props_Opacity}" Style="{StaticResource FieldLabel}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                      Value="{Binding OpacityValue, Mode=TwoWay}"
                      AutomationProperties.Name="{l:Loc Props_Opacity}" />
              <ui:NumberBox Grid.Column="1" Width="72" Margin="8,0,0,0" SpinButtonPlacementMode="Hidden"
                            Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" MaxDecimalPlaces="0"
                            ClearButtonEnabled="False"
                            Value="{Binding OpacityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="{l:Loc Props_Opacity}" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="{l:Loc Panel_Layers}">
      <controls:LayersPanel DataContext="{Binding Layers}" />
    </TabItem>
  </TabControl>
</UserControl>

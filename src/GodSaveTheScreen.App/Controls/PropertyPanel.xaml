<UserControl x:Class="GodSaveTheScreen.App.Controls.PropertyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:GodSaveTheScreen.App.Localization"
             xmlns:controls="clr-namespace:GodSaveTheScreen.App.Controls"
             xmlns:core="clr-namespace:GodSaveTheScreen.Core.Annotations;assembly=GodSaveTheScreen.Core">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <controls:ArgbColorBrushConverter x:Key="ColorBrush" />

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,8,0,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="0,0,2,2" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="PanelColorButton" TargetType="controls:ColorButton">
      <Setter Property="RecentColors" Value="{Binding DataContext.Properties.RecentColors, RelativeSource={RelativeSource AncestorType=controls:PropertyPanel}}" />
      <Setter Property="PipetteCommand" Value="{Binding DataContext.Properties.PipetteCommand, RelativeSource={RelativeSource AncestorType=controls:PropertyPanel}}" />
      <Setter Property="RememberCommand" Value="{Binding DataContext.Properties.RememberColorCommand, RelativeSource={RelativeSource AncestorType=controls:PropertyPanel}}" />
    </Style>
    <!-- Farbwahl in Zeilen mit mehreren Feldern: nur so breit wie nötig -->
    <Style x:Key="CompactColor" TargetType="controls:ColorButton" BasedOn="{StaticResource PanelColorButton}">
      <Setter Property="Width" Value="56" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <!-- Zahlenfeld neben einem Regler -->
    <Style x:Key="SliderSpin" TargetType="controls:SpinBox">
      <Setter Property="Width" Value="84" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style x:Key="ResetButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="ToolTip" Value="{l:Loc Emoji_ResetRotation}" />
    </Style>
    <!-- Lange Beschriftungen umbrechen statt abschneiden (Panel ist schmal) -->
    <DataTemplate x:Key="WrappingText">
      <TextBlock Text="{Binding}" TextWrapping="Wrap" />
    </DataTemplate>
    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="ContentTemplate" Value="{StaticResource WrappingText}" />
    </Style>
    <Style x:Key="WrapButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" />
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FontComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="SelectedValuePath" Value="Key" />
      <Setter Property="IsTextSearchEnabled" Value="True" />
      <Setter Property="TextSearch.TextPath" Value="DisplayName" />
      <Setter Property="MaxDropDownHeight" Value="360" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
      <Setter Property="ItemsPanel">
        <Setter.Value>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding DisplayName}" FontFamily="{Binding Family}" FontSize="15" />
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Kurzfassung im Kopf zugeklappter Abschnitte -->
    <Style x:Key="SummarySwatch" TargetType="Border">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SummaryText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <ControlTemplate x:Key="SectionHeaderTemplate" TargetType="ToggleButton">
      <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" />
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Aufklappbare Karte: Titel, Kurzfassung (nur zugeklappt), optionaler Ein/Aus-Schalter, Pfeil -->
    <Style TargetType="controls:PanelSection">
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="controls:PanelSection">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
              <StackPanel>
                <Grid MinHeight="38">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ToggleButton x:Name="HeaderButton"
                                Grid.ColumnSpan="4"
                                FocusVisualStyle="{x:Null}"
                                Template="{StaticResource SectionHeaderTemplate}"
                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
                  <ContentPresenter ContentSource="Header" Margin="12,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                    TextElement.FontWeight="SemiBold" />
                  <ContentPresenter x:Name="SummaryHost" Grid.Column="1" Content="{TemplateBinding Summary}" Margin="0,0,4,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.75" />
                  <ui:ToggleSwitch x:Name="PART_Switch" Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                   IsChecked="{Binding IsOn, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   ToolTip="{l:Loc Section_Switch}" AutomationProperties.Name="{l:Loc Section_Switch}" />
                  <ui:SymbolIcon x:Name="Chevron" Grid.Column="3" Symbol="ChevronDown20" Margin="6,0,12,0" VerticalAlignment="Center"
                                 IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5" />
                </Grid>
                <ContentPresenter x:Name="Body" Margin="12,0,12,12" Visibility="Collapsed" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                <Setter TargetName="SummaryHost" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Chevron" Property="RenderTransform">
                  <Setter.Value>
                    <RotateTransform Angle="180" />
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="HasSwitch" Value="True">
                <Setter TargetName="PART_Switch" Property="Visibility" Value="Visible" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="HasSwitch" Value="True" />
                  <Condition Property="IsOn" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="SummaryHost" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="HeaderButton" Property="IsEnabled" Value="False" />
                <Setter TargetName="Chevron" Property="Opacity" Value="0.35" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <TabControl Padding="0" Margin="0">
    <TabItem Header="{l:Loc Panel_Properties}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel Margin="8,4,2,12" controls:PanelSection.Store="{Binding PanelSections}">
          <TextBlock Text="{l:Loc Props_NothingSelected}" TextWrapping="Wrap" Opacity="0.6" Margin="0,12,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasPanelContent}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <TextBlock Text="{Binding PanelHeader}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,8,0,8"
                     Visibility="{Binding HasPanelContent, Converter={StaticResource BoolToVisibility}}" />

          <!-- Text -->
          <StackPanel DataContext="{Binding TextProperties}" Visibility="{Binding IsApplicable, Converter={StaticResource BoolToVisibility}}">
            <controls:PanelSection Header="{l:Loc Section_Font}" SectionKey="Font">
              <controls:PanelSection.Summary>
                <TextBlock Style="{StaticResource SummaryText}" MaxWidth="120">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} · {1:0.#}">
                      <Binding Path="FontFamilyName" />
                      <Binding Path="FontSize" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </controls:PanelSection.Summary>
              <StackPanel>
                <TextBlock Text="{l:Loc Text_Font}" Style="{StaticResource FieldLabel}" />
                <ComboBox Style="{StaticResource FontComboBox}" ItemsSource="{Binding Fonts}" SelectedValue="{Binding FontFamilyName, Mode=TwoWay}"
                          AutomationProperties.Name="{l:Loc Text_Font}" />
                <TextBlock Text="{l:Loc Text_FontMissing}" Foreground="#F5A623" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding IsFontMissing, Converter={StaticResource BoolToVisibility}}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="84" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{l:Loc Text_Typeface}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Typefaces}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedTypeface, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" AutomationProperties.Name="{l:Loc Text_Typeface}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:Loc Text_Size}" Style="{StaticResource FieldLabel}" />
                    <controls:SpinBox Minimum="1" Maximum="999" SmallChange="1" LargeChange="10" Decimals="1" Unit="pt"
                                      Value="{Binding FontSize}" AutomationProperties.Name="{l:Loc Text_Size}" />
                  </StackPanel>
                </Grid>
                <WrapPanel Margin="0,8,0,0">
                  <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsBold, Mode=TwoWay}" ToolTip="{l:Loc Text_Bold}" AutomationProperties.Name="{l:Loc Text_Bold}">
                    <ui:SymbolIcon Symbol="TextBold24" />
                  </ToggleButton>
                  <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsItalic, Mode=TwoWay}" ToolTip="{l:Loc Text_Italic}" AutomationProperties.Name="{l:Loc Text_Italic}">
                    <ui:SymbolIcon Symbol="TextItalic24" />
                  </ToggleButton>
                  <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsUnderline, Mode=TwoWay}" ToolTip="{l:Loc Text_Underline}" AutomationProperties.Name="{l:Loc Text_Underline}">
                    <ui:SymbolIcon Symbol="TextUnderline24" />
                  </ToggleButton>
                  <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsStrikethrough, Mode=TwoWay}" ToolTip="{l:Loc Text_Strikethrough}" AutomationProperties.Name="{l:Loc Text_Strikethrough}">
                    <ui:SymbolIcon Symbol="TextStrikethrough24" />
                  </ToggleButton>
                  <Rectangle Width="1" Height="22" Margin="3,0,5,2" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />
                  <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsAlignLeft, Mode=TwoWay}" ToolTip="{l:Loc Text_AlignLeft}" AutomationProperties.Name="{l:Loc Text_AlignLeft}">
                    <ui:SymbolIcon Symbol="TextAlignLeft24" />
                  </ToggleButton>
                  <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsAlignCenter, Mode=TwoWay}" ToolTip="{l:Loc Text_AlignCenter}" AutomationProperties.Name="{l:Loc Text_AlignCenter}">
                    <ui:SymbolIcon Symbol="TextAlignCenter24" />
                  </ToggleButton>
                  <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding IsAlignRight, Mode=TwoWay}" ToolTip="{l:Loc Text_AlignRight}" AutomationProperties.Name="{l:Loc Text_AlignRight}">
                    <ui:SymbolIcon Symbol="TextAlignRight24" />
                  </ToggleButton>
                </WrapPanel>
                <TextBlock Text="{l:Loc Text_Color}" Style="{StaticResource FieldLabel}" />
                <controls:ColorButton Style="{StaticResource CompactColor}" SelectedColor="{Binding TextColor, Mode=TwoWay}" />
              </StackPanel>
            </controls:PanelSection>

            <controls:PanelSection Header="{l:Loc Text_Outline}" SectionKey="Outline" DefaultExpanded="False" HasSwitch="True"
                                   IsOn="{Binding IsOutlineOn}">
              <controls:PanelSection.Summary>
                <StackPanel Orientation="Horizontal">
                  <Border Style="{StaticResource SummarySwatch}" Background="{Binding OutlineColor, Converter={StaticResource ColorBrush}}" />
                  <TextBlock Style="{StaticResource SummaryText}" Text="{Binding OutlineThickness, StringFormat={}{0:0.#} px}" />
                </StackPanel>
              </controls:PanelSection.Summary>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{l:Loc Field_Color}" Style="{StaticResource FieldLabel}" />
                  <controls:ColorButton Style="{StaticResource CompactColor}" SelectedColor="{Binding OutlineColor, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="{l:Loc Field_Width}" Style="{StaticResource FieldLabel}" />
                  <controls:SpinBox Minimum="0" Maximum="50" SmallChange="0.5" LargeChange="2" Decimals="1" Unit="px"
                                    Value="{Binding OutlineThickness}" AutomationProperties.Name="{l:Loc Text_OutlineWidth}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="{l:Loc Field_Blur}" Style="{StaticResource FieldLabel}" />
                  <controls:SpinBox Minimum="0" Maximum="50" SmallChange="1" LargeChange="5" Decimals="1"
                                    Value="{Binding OutlineBlur}" AutomationProperties.Name="{l:Loc Text_OutlineBlur}" />
                </StackPanel>
              </Grid>
            </controls:PanelSection>

            <controls:PanelSection Header="{l:Loc Text_Background}" SectionKey="Background" DefaultExpanded="False" HasSwitch="True"
                                   IsOn="{Binding IsBackgroundOn}">
              <controls:PanelSection.Summary>
                <Border Style="{StaticResource SummarySwatch}" Background="{Binding BackgroundColor, Converter={StaticResource ColorBrush}}" />
              </controls:PanelSection.Summary>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{l:Loc Field_Color}" Style="{StaticResource FieldLabel}" />
                  <controls:ColorButton Style="{StaticResource CompactColor}" SelectedColor="{Binding BackgroundColor, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="{l:Loc Props_CornerRadius}" Style="{StaticResource FieldLabel}" ToolTip="{l:Loc Props_CornerRadius}" />
                  <controls:SpinBox Minimum="0" Maximum="500" SmallChange="1" LargeChange="10" Unit="px"
                                    Value="{Binding BackgroundCornerRadius}" AutomationProperties.Name="{l:Loc Props_CornerRadius}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="{l:Loc Callout_Padding}" Style="{StaticResource FieldLabel}" ToolTip="{l:Loc Text_BackgroundPadding}" />
                  <controls:SpinBox Minimum="0" Maximum="200" SmallChange="1" LargeChange="10" Unit="px"
                                    Value="{Binding BackgroundPadding}" AutomationProperties.Name="{l:Loc Text_BackgroundPadding}" />
                </StackPanel>
              </Grid>
            </controls:PanelSection>
          </StackPanel>

          <!-- Marker -->
          <StackPanel DataContext="{Binding MarkerProperties}" Visibility="{Binding IsApplicable, Converter={StaticResource BoolToVisibility}}">
            <controls:PanelSection Header="{l:Loc Section_Style}" SectionKey="Style">
              <controls:PanelSection.Summary>
                <StackPanel Orientation="Horizontal">
                  <Border Style="{StaticResource SummarySwatch}" Background="{Binding FillColor, Converter={StaticResource ColorBrush}}" />
                  <TextBlock Style="{StaticResource SummaryText}" Text="{Binding Size, StringFormat={}{0:0} px}" />
                </StackPanel>
              </controls:PanelSection.Summary>
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="84" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{l:Loc Marker_Shape}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding ShapeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Shape, Mode=TwoWay}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="{l:Loc Marker_Shape}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:Loc Marker_Size}" Style="{StaticResource FieldLabel}" />
                    <controls:SpinBox Minimum="8" Maximum="400" SmallChange="2" LargeChange="10" Unit="px"
                                      Value="{Binding Size}" AutomationProperties.Name="{l:Loc Marker_Size}" />
                  </StackPanel>
                </Grid>
                <UniformGrid Columns="3">
                  <StackPanel Margin="0,0,4,0">
                    <TextBlock Text="{l:Loc Marker_Fill}" Style="{StaticResource FieldLabel}" ToolTip="{l:Loc Marker_Fill}" />
                    <controls:ColorButton Style="{StaticResource CompactColor}" SelectedColor="{Binding FillColor, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Margin="2,0,2,0">
                    <TextBlock Text="{l:Loc Marker_TextColor}" Style="{StaticResource FieldLabel}" ToolTip="{l:Loc Marker_TextColor}" />
                    <controls:ColorButton Style="{StaticResource CompactColor}" SelectedColor="{Binding TextColor, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Margin="4,0,0,0">
                    <TextBlock Text="{l:Loc Marker_Outline}" Style="{StaticResource FieldLabel}" ToolTip="{l:Loc Marker_Outline}" />
                    <controls:ColorButton Style="{StaticResource CompactColor}" SelectedColor="{Binding OutlineColor, Mode=TwoWay}" />
                  </StackPanel>
                </UniformGrid>
              </StackPanel>
            </controls:PanelSection>

            <controls:PanelSection Header="{l:Loc Section_Numbering}" SectionKey="Numbering">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{l:Loc Marker_StartNumber}" Style="{StaticResource FieldLabel}" />
                    <controls:SpinBox Minimum="0" Maximum="9999" SmallChange="1" LargeChange="5"
                                      Value="{Binding StartNumber}" AutomationProperties.Name="{l:Loc Marker_StartNumber}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Visibility="{Binding ShowNumber, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{l:Loc Marker_Number}" Style="{StaticResource FieldLabel}" />
                    <controls:SpinBox Minimum="0" Maximum="9999" SmallChange="1" LargeChange="5"
                                      Value="{Binding Number}" AutomationProperties.Name="{l:Loc Marker_Number}" />
                  </StackPanel>
                </Grid>
                <Button Style="{StaticResource WrapButton}" Content="{l:Loc Marker_RenumberZ}" Margin="0,10,0,0"
                        Command="{Binding RenumberCommand}" CommandParameter="{x:Static core:MarkerOrder.ZOrder}" />
                <Button Style="{StaticResource WrapButton}" Content="{l:Loc Marker_RenumberCreation}" Margin="0,6,0,0"
                        Command="{Binding RenumberCommand}" CommandParameter="{x:Static core:MarkerOrder.Creation}" />
              </StackPanel>
            </controls:PanelSection>
          </StackPanel>

          <!-- Freihand, Radierer, Unschärfe, Lupe -->
          <StackPanel DataContext="{Binding ToolOptions}" Visibility="{Binding IsApplicable, Converter={StaticResource BoolToVisibility}}">
            <controls:PanelSection Header="{l:Loc Section_Drawing}" SectionKey="Drawing"
                                   Visibility="{Binding ShowStroke, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <TextBlock Text="{l:Loc Opt_Smoothing}" Style="{StaticResource FieldLabel}" />
                <DockPanel>
                  <controls:SpinBox DockPanel.Dock="Right" Style="{StaticResource SliderSpin}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" Unit="%"
                                    Value="{Binding SmoothingPercent}" AutomationProperties.Name="{l:Loc Opt_Smoothing}" />
                  <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                          Value="{Binding SmoothingPercent, Mode=TwoWay, TargetNullValue=0}"
                          AutomationProperties.Name="{l:Loc Opt_Smoothing}" />
                </DockPanel>
                <CheckBox Content="{l:Loc Opt_Pressure}" Margin="0,10,0,0" IsChecked="{Binding UsePressure, Mode=TwoWay}" />
                <CheckBox Content="{l:Loc Opt_HighlighterBehind}" Margin="0,6,0,0" IsChecked="{Binding HighlightersBehind, Mode=TwoWay}" />
              </StackPanel>
            </controls:PanelSection>

            <StackPanel Margin="0,0,0,8" Visibility="{Binding ShowEraser, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{l:Loc Opt_EraserHint}" TextWrapping="Wrap" Opacity="0.75" />
              <CheckBox Content="{l:Loc Opt_EraserAll}" Margin="0,10,0,0" IsChecked="{Binding EraserAllObjects, Mode=TwoWay}" />
            </StackPanel>

            <controls:PanelSection Header="{l:Loc Section_Effect}" SectionKey="Effect"
                                   Visibility="{Binding ShowBlur, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <TextBlock Text="{l:Loc Blur_Mode}" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding ModeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Mode, Mode=TwoWay}" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="{l:Loc Blur_Mode}" />
                <StackPanel Visibility="{Binding ShowStrength, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="{l:Loc Blur_Strength}" Style="{StaticResource FieldLabel}" />
                  <DockPanel>
                    <controls:SpinBox DockPanel.Dock="Right" Style="{StaticResource SliderSpin}" Minimum="2" Maximum="100" SmallChange="1" LargeChange="5" Unit="px"
                                      Value="{Binding Strength}" AutomationProperties.Name="{l:Loc Blur_Strength}" />
                    <Slider Minimum="2" Maximum="100" SmallChange="1" LargeChange="5" VerticalAlignment="Center"
                            Value="{Binding Strength, Mode=TwoWay, TargetNullValue=2}"
                            AutomationProperties.Name="{l:Loc Blur_Strength}" />
                  </DockPanel>
                </StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="84" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{l:Loc Blur_Shape}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding RegionShapeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding RegionShapeValue, Mode=TwoWay}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="{l:Loc Blur_Shape}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:Loc Blur_Feather}" Style="{StaticResource FieldLabel}" ToolTip="{l:Loc Blur_Feather}" />
                    <controls:SpinBox Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" Unit="px"
                                      Value="{Binding FeatherEdge}" AutomationProperties.Name="{l:Loc Blur_Feather}" />
                  </StackPanel>
                </Grid>
                <StackPanel Visibility="{Binding ShowRedactColor, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="{l:Loc Blur_RedactColor}" Style="{StaticResource FieldLabel}" />
                  <controls:ColorButton Style="{StaticResource CompactColor}" SelectedColor="{Binding RedactColor, Mode=TwoWay}" />
                </StackPanel>
                <TextBlock Text="{l:Loc Blur_Warning}" TextWrapping="Wrap" Foreground="#F5A623" Margin="0,10,0,0"
                           Visibility="{Binding ShowBlurWarning, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </controls:PanelSection>

            <controls:PanelSection Header="{l:Loc Section_Magnifier}" SectionKey="Magnifier"
                                   Visibility="{Binding ShowMagnifier, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <TextBlock Text="{l:Loc Mag_Zoom}" Style="{StaticResource FieldLabel}" />
                <DockPanel>
                  <controls:SpinBox DockPanel.Dock="Right" Style="{StaticResource SliderSpin}" Minimum="1.5" Maximum="8" SmallChange="0.5" LargeChange="1" Decimals="1" Unit="×"
                                    Value="{Binding Zoom}" AutomationProperties.Name="{l:Loc Mag_Zoom}" />
                  <Slider Minimum="1.5" Maximum="8" SmallChange="0.5" LargeChange="1" VerticalAlignment="Center"
                          Value="{Binding Zoom, Mode=TwoWay, TargetNullValue=2}"
                          AutomationProperties.Name="{l:Loc Mag_Zoom}" />
                </DockPanel>
                <TextBlock Text="{l:Loc Mag_Shape}" Style="{StaticResource FieldLabel}" />

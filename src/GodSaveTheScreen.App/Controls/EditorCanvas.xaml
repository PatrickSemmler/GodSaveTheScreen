<UserControl x:Class="GodSaveTheScreen.App.Controls.EditorCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:GodSaveTheScreen.App.Localization"
             xmlns:controls="clr-namespace:GodSaveTheScreen.App.Controls"
             Focusable="False">
  <ScrollViewer x:Name="Scroller"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                Focusable="False"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                PreviewMouseWheel="OnPreviewMouseWheel"
                SizeChanged="OnScrollerSizeChanged">
    <!-- Rahmen = sichtbarer Bereich (Zuschnitt); die Zeichenfläche liegt in Originalkoordinaten darin und wird verschoben. -->
    <Grid x:Name="Frame"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Margin="24"
          ClipToBounds="True">
      <!-- ClipToBounds nur bei Zuschnitt (EditorCanvas.ApplyViewRect): sonst bleiben gezogene Objekte außerhalb sichtbar. -->
      <Grid.LayoutTransform>
        <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
      </Grid.LayoutTransform>
    <!-- Canvas statt Grid: ein Grid würde die größere Zeichenfläche auf die Rahmengröße zuschneiden (Layout-Clip wandert beim Verschieben mit).
         Der Host füllt den ganzen Rahmen (Schachbrett = transparenter Bereich) und empfängt die Maus auch neben dem Basisbild. -->
    <Canvas x:Name="SurfaceHost"
            MouseLeftButtonDown="OnMouseLeftButtonDown"
            MouseLeftButtonUp="OnMouseLeftButtonUp"
            MouseRightButtonDown="OnMouseRightButtonDown"
            MouseMove="OnMouseMove"
            ContextMenuOpening="OnContextMenuOpening"
            MouseLeave="OnMouseLeave"
            MouseDown="OnMouseDown"
            MouseUp="OnMouseUp">
      <Canvas.ContextMenu>
        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
          <MenuItem Header="{l:Loc Menu_Cut}" Command="{Binding CutCommand}" IsEnabled="{Binding HasSelection}" InputGestureText="{l:Shortcut Ctrl+X}" />
          <MenuItem Header="{l:Loc Menu_Copy}" Command="{Binding CopyCommand}" InputGestureText="{l:Shortcut Ctrl+C}" />
          <MenuItem Header="{l:Loc Menu_Paste}" Command="{Binding PasteCommand}" InputGestureText="{l:Shortcut Ctrl+V}" />
          <MenuItem Header="{l:Loc Menu_PasteAsImage}" Command="{Binding PasteAsImageCommand}" InputGestureText="{l:Shortcut Ctrl+Shift+V}" />
          <MenuItem Header="{l:Loc Menu_InsertImage}" Command="{Binding InsertImageCommand}" />
          <MenuItem Header="{l:Loc Menu_Duplicate}" Command="{Binding DuplicateCommand}" IsEnabled="{Binding HasSelection}" InputGestureText="{l:Shortcut Ctrl+D}" />
          <MenuItem Header="{l:Loc Menu_Delete}" Command="{Binding DeleteSelectionCommand}" IsEnabled="{Binding HasSelection}" InputGestureText="{l:Shortcut Del}" />
          <Separator />
          <MenuItem Header="{l:Loc Menu_Order}" IsEnabled="{Binding HasSelection}">
            <MenuItem Header="{l:Loc Menu_BringToFront}" Command="{Binding BringToFrontCommand}" InputGestureText="{l:Shortcut Ctrl+Shift+]}" />
            <MenuItem Header="{l:Loc Menu_BringForward}" Command="{Binding BringForwardCommand}" InputGestureText="{l:Shortcut Ctrl+]}" />
            <MenuItem Header="{l:Loc Menu_SendBackward}" Command="{Binding SendBackwardCommand}" InputGestureText="{l:Shortcut Ctrl+[}" />
            <MenuItem Header="{l:Loc Menu_SendToBack}" Command="{Binding SendToBackCommand}" InputGestureText="{l:Shortcut Ctrl+Shift+[}" />
          </MenuItem>
          <MenuItem Header="{l:Loc Menu_Lock}" Command="{Binding ToggleLockSelectionCommand}" IsEnabled="{Binding HasSelection}" />
        </ContextMenu>
      </Canvas.ContextMenu>
    <Grid x:Name="Surface"
          Focusable="True"
          FocusVisualStyle="{x:Null}"
          Background="Transparent"
          SnapsToDevicePixels="False"
          LostMouseCapture="OnLostMouseCapture">
      <Image x:Name="BaseImage" Stretch="Fill" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
      <controls:AnnotationLayer x:Name="Annotations" />
      <controls:InteractionLayer x:Name="Interaction" />
      <Canvas x:Name="Overlay" />
    </Grid>
    </Canvas>
    </Grid>
  </ScrollViewer>
</UserControl>

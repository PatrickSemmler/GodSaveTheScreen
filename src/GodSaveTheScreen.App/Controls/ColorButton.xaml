<UserControl x:Class="GodSaveTheScreen.App.Controls.ColorButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:GodSaveTheScreen.App.Localization"
             xmlns:cp="clr-namespace:ColorPicker;assembly=ColorPicker">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/ColorPicker;component/Styles/DefaultColorPickerStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <ControlTemplate x:Key="SwatchTemplate" TargetType="Button">
        <Border x:Name="Frame"
                Background="{TemplateBinding Background}"
                BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="3">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="SwatchStyle" TargetType="Button">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template" Value="{StaticResource SwatchTemplate}" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <ToggleButton x:Name="Toggle"
                  AutomationProperties.Name="{l:Loc Color_Choose}"
                  Height="30"
                  MinWidth="56"
                  Padding="4"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch">
      <Border x:Name="SwatchHost" CornerRadius="3" ClipToBounds="True" MinHeight="18">
        <Grid>
          <Rectangle x:Name="SwatchChecker" />
          <Rectangle x:Name="SwatchColor" />
          <Path x:Name="NoneSlash"
                Data="M 0,1 L 1,0"
                Stretch="Fill"
                Stroke="#E81123"
                StrokeThickness="2"
                Visibility="Collapsed" />
          <TextBlock x:Name="MixedText"
                     Text="—"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Visibility="Collapsed" />
        </Grid>
      </Border>
    </ToggleButton>
    <Popup x:Name="PickerPopup"
           IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}"
           PlacementTarget="{Binding ElementName=Toggle}"
           Placement="Bottom"
           StaysOpen="False"
           AllowsTransparency="True"
           Closed="OnPopupClosed">
      <Border Margin="8"
              Padding="10"
              CornerRadius="8"
              BorderThickness="1"
              Background="{DynamicResource ApplicationBackgroundBrush}"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
        <Border.Effect>
          <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" />
        </Border.Effect>
        <StackPanel Width="250">
          <DockPanel>
            <ui:Button DockPanel.Dock="Right"
                       Icon="{ui:SymbolIcon Eyedropper24}"
                       ToolTip="{l:Loc Color_Pipette}"
                       AutomationProperties.Name="{l:Loc Color_Pipette}"
                       Click="OnPipetteClick" />
            <ui:Button Content="{l:Loc Color_None}" HorizontalAlignment="Left" Click="OnNoneClick" />
          </DockPanel>
          <TextBlock Text="{l:Loc Color_Palette}" Margin="0,8,0,2" Opacity="0.7" />
          <WrapPanel x:Name="PalettePanel" />
          <TextBlock x:Name="RecentLabel" Text="{l:Loc Color_Recent}" Margin="0,8,0,2" Opacity="0.7" />
          <WrapPanel x:Name="RecentPanel" />
          <cp:StandardColorPicker x:Name="Picker"
                                  Margin="0,8,0,0"
                                  Height="360"
                                  ShowAlpha="True"
                                  ColorChanged="OnPickerColorChanged"
                                  Style="{StaticResource DefaultColorPickerStyle}" />
          <ui:TextBox x:Name="HexBox"
                   Margin="0,8,0,0"
                   MaxLength="9"
                   PlaceholderText="#AARRGGBB"
                   AutomationProperties.Name="{l:Loc Color_Hex}"
                   KeyDown="OnHexKeyDown"
                   LostFocus="OnHexLostFocus" />
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>

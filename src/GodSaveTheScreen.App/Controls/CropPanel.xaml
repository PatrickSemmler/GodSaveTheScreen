<UserControl x:Class="GodSaveTheScreen.App.Controls.CropPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:GodSaveTheScreen.App.Localization">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,10,0,4" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
    <StackPanel Margin="12,8,4,12" DataContext="{Binding Crop}">
      <TextBlock Text="{l:Loc Crop_Title}" FontWeight="SemiBold" />
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:Button Grid.Column="0" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Content="{l:Loc Crop_Apply}"
                   Command="{Binding ApplyCommand}" HorizontalAlignment="Stretch" Margin="0,0,3,0" ToolTip="Enter" />
        <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Dismiss24}" Content="{l:Loc Crop_Cancel}"
                   Command="{Binding CancelCommand}" HorizontalAlignment="Stretch" Margin="3,0,0,0" ToolTip="Esc" />
      </Grid>
      <ui:Button Margin="0,6,0,0" Icon="{ui:SymbolIcon ArrowReset24}" Content="{l:Loc Crop_Reset}" Command="{Binding ResetCommand}" HorizontalAlignment="Stretch" />

      <TextBlock Text="{l:Loc Crop_Aspect}" Style="{StaticResource FieldLabel}" />
      <ComboBox ItemsSource="{Binding AspectOptions}"
                SelectedItem="{Binding SelectedAspect, Mode=TwoWay}"
                DisplayMemberPath="Label"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="{l:Loc Crop_Aspect}" />
      <Grid Margin="0,6,0,0" Visibility="{Binding IsCustomAspect, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:NumberBox Grid.Column="0" Minimum="1" Maximum="10000" MaxDecimalPlaces="2" ClearButtonEnabled="False"
                      Value="{Binding CustomWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      AutomationProperties.Name="{l:Loc Crop_CustomWidth}" />
        <TextBlock Grid.Column="1" Text=":" Margin="6,0" VerticalAlignment="Center" />
        <ui:NumberBox Grid.Column="2" Minimum="1" Maximum="10000" MaxDecimalPlaces="2" ClearButtonEnabled="False"
                      Value="{Binding CustomHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      AutomationProperties.Name="{l:Loc Crop_CustomHeight}" />
      </Grid>

      <TextBlock Text="{l:Loc Crop_Position}" Style="{StaticResource FieldLabel}" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:NumberBox Grid.Column="0" Margin="0,0,3,0" Minimum="0" MaxDecimalPlaces="0" ClearButtonEnabled="False" PlaceholderText="X"
                      Value="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="X" />
        <ui:NumberBox Grid.Column="1" Margin="3,0,0,0" Minimum="0" MaxDecimalPlaces="0" ClearButtonEnabled="False" PlaceholderText="Y"
                      Value="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Y" />
      </Grid>
      <TextBlock Text="{l:Loc Crop_Size}" Style="{StaticResource FieldLabel}" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:NumberBox Grid.Column="0" Margin="0,0,3,0" Minimum="1" MaxDecimalPlaces="0" ClearButtonEnabled="False"
                      Value="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Loc Crop_Width}" />
        <ui:NumberBox Grid.Column="1" Margin="3,0,0,0" Minimum="1" MaxDecimalPlaces="0" ClearButtonEnabled="False"
                      Value="{Binding Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Loc Crop_Height}" />
      </Grid>

      <TextBlock Text="{l:Loc Crop_Commands}" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
      <ui:Button Icon="{ui:SymbolIcon SelectObject24}" Content="{l:Loc Crop_ToObjects}" Command="{Binding CropToObjectsCommand}" HorizontalAlignment="Stretch" />
      <ui:Button Margin="0,6,0,0" Icon="{ui:SymbolIcon AutoFitHeight24}" Content="{l:Loc Crop_RemoveBorder}" Command="{Binding RemoveBorderCommand}" HorizontalAlignment="Stretch" />
      <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Hint}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <TextBlock Text="{l:Loc Crop_Help}" TextWrapping="Wrap" Opacity="0.6" Margin="0,16,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>

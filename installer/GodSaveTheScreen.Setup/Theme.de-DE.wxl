  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="Vorherige Version" />
  <String Id="HelpHeader" Value="Setup-Hilfe" />
  <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [Ordner] - installiert, repariert, deinstalliert oder&#xA;   legt eine vollständige lokale Kopie des Setups im Ordner an. Standard ist Installieren.&#xA;&#xA;/passive | /quiet - minimale Oberfläche ohne Rückfragen bzw. keine Oberfläche und&#xA;   keine Rückfragen. Standardmäßig werden Oberfläche und alle Rückfragen angezeigt.&#xA;&#xA;InstallScope=PerMachine - für alle Benutzer installieren (Administratorrechte nötig).&#xA;   Standard: nur für den aktuellen Benutzer.&#xA;InstallFolder=Ordner - abweichender Zielordner.&#xA;StartMenuShortcut=0 - keine Verknüpfung im Startmenü.&#xA;&#xA;/norestart   - keinen Neustart durchführen. Standardmäßig wird vor einem Neustart gefragt.&#xA;/log log.txt - Protokoll in diese Datei schreiben. Standardmäßig wird es in %TEMP% angelegt." />
  <String Id="HelpCloseButton" Value="&amp;Schließen" />
